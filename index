function onYear() {
  S.year = document.getElementById('sel-year').value;
  S.make=''; S.model=''; S.platformId=''; S.kitId=''; S.sel={};
  setDiscount(0);
  populateMakes(); populateModels();
  render();
}

function onMake() {
  S.make = document.getElementById('sel-make').value;
  S.model=''; S.platformId=''; S.kitId=''; S.sel={};
  setDiscount(0);
  populateModels();
  render();
}

function onModel() {
  const val = document.getElementById('sel-model').value;
  S.model = val;
  S.platformId = '';
  S.kitId = '';
  S.sel = {};
  setDiscount(0);
  const allKits = getAllKitsForModel();
  if(allKits.length===1) {
    S.platformId = allKits[0].platformId;
    S.kitId = allKits[0].kit.id;
  } else if(allKits.length>1) {
    S.platformId = getPlatformsForModel(S.year, S.make, val)[0]?.id || '';
  }
  render();
}

function populateMakes() {
  const el = document.getElementById('sel-make');
  el.innerHTML = '<option value="">— Make —</option>';
  if(!S.year){ el.disabled=true; return; }
  const makes = getMakes(S.year);
  makes.forEach(m=>{ const o=document.createElement('option'); o.value=o.textContent=m; el.appendChild(o); });
  el.disabled = makes.length===0;
  el.className = 'ymm-sel';
}

function populateModels() {
  const el = document.getElementById('sel-model');
  el.innerHTML = '<option value="">— Model —</option>';
  if(!S.year||!S.make){ el.disabled=true; return; }
  const platforms = getModels(S.year, S.make);
  // Sort: by leading number (2500 < 3500, F-250 < F-350), then alphabetically
  const sorted = [...platforms].sort((a,b)=>{
    const na=parseInt((a.model||'').match(/\d+/)?.[0])||99999;
    const nb=parseInt((b.model||'').match(/\d+/)?.[0])||99999;
    if(na!==nb) return na-nb;
    return (a.model||'').localeCompare(b.model||'');
  });
  const seen = new Set();
  sorted.forEach(p=>{
    const name = p.model;
    if(seen.has(name)) return;
    seen.add(name);
    const o=document.createElement('option'); o.value=name; o.textContent=name; el.appendChild(o);
  });
  el.disabled = seen.size===0;
  el.className = 'ymm-sel';
}

function selectKit(kitId) {
  const match = getAllKitsForModel().find(k=>k.kit.id===kitId);
  if(match) S.platformId = match.platformId;
  S.kitId = kitId;
  S.sel = {};
  render();
}

function toggleStep(key, val) {
  const cur = Array.isArray(S.sel[key]) ? [...S.sel[key]] : [];
  const i = cur.indexOf(val);
  if(i === -1) cur.push(val); else cur.splice(i, 1);
  S.sel[key] = cur;
  render();
}
function selectAllSteps(key) {
  const p = getActivePlatform(); if(!p) return;
  const step = p.steps.find(s=>s.key===key); if(!step) return;
  const choices = typeof step.choices==='function' ? step.choices(S.kitId, S.sel) : step.choices;
  S.sel[key] = (choices||[]).map(c=>c.val);
  render();
}
function clearStep(key) { S.sel[key] = []; render(); }

function selectStep(key, val) {
  S.sel[key] = val;
  clearDownstreamKeys(key);
  applyDefaults(key);
  render();
}

// Selections that imply another selection. A tall lift is the only build that
// clears the 365, so it becomes the default the moment one is chosen.
const TALL_LIFTS = ['5-6','6std','660'];
const MIRRORS = {fbLight:'rbLight', fbHooks:'rbHooks'};
function applyDefaults(changedKey) {
  if(changedKey === 'suspension') {
    if(TALL_LIFTS.includes(S.sel.suspension)) S.sel.tires = 't365';
    else if(S.sel.tires === 't365')           S.sel.tires = 't335';
  }
  // Front bumper lights and hooks set the rear to match — trucks are built
  // in one finish. The rear step stays editable if they want to differ.
  const mirrored = MIRRORS[changedKey];
  if(mirrored) S.sel[mirrored] = S.sel[changedKey];

  // Choosing a front bumper brings the matching rear with it. Which rear that
  // is depends on the platform, and on the chassis cab, on the bed.
  if(changedKey === 'front' && S.sel.front && S.sel.front !== 'none') {
    const p = getActivePlatform();
    if(p) {
      const isCC = /cc$/.test(p.id);
      if(!isCC) S.sel.rear = 'rdelta';
      else if(S.sel.bed === 'sherptek') S.sel.rear = 'rbravo';
      else if(S.sel.bed === 'conv')     S.sel.rear = 'rdelta';
    }
  }
}

function clearDownstreamKeys(changedKey) {
  // Smart clear: only remove a downstream selection if the step is no longer visible
  // or the saved value is no longer among the valid choices. Processed in order so
  // each cleared step updates S.sel before the next one is evaluated.
  const p = getActivePlatform();
  if(!p) return;
  let found = false;
  for(const step of p.steps) {
    if(step.key === changedKey) { found = true; continue; }
    if(!found) continue;
    const currentVal = S.sel[step.key];
    if(currentVal === undefined) continue; // already unset — nothing to do
    if(Array.isArray(currentVal)) continue; // multi-select steps manage themselves
    // Drop if step is no longer visible
    const isVisible = step.condition ? step.condition(S.sel, S.kitId) : true;
    if(!isVisible) { delete S.sel[step.key]; continue; }
    // Drop if the saved value is no longer a valid choice
    try {
      const choices = typeof step.choices === 'function'
        ? step.choices(S.kitId, S.sel)
        : step.choices;
      if(choices && !choices.some(c => c.val === currentVal)) {
        delete S.sel[step.key];
      }
    } catch(e) {
      delete S.sel[step.key]; // choices fn errored with new upstream state — clear to be safe
    }
  }
}

// ═══════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════
function autoSelectSingleChoiceSteps(platform) {
  let changed = false;
  for(const step of platform.steps) {
    const isVisible = step.condition ? step.condition(S.sel, S.kitId) : true;
    if(!isVisible) continue;
    if(S.sel[step.key] !== undefined) continue;
    const choices = typeof step.choices === 'function' ? step.choices(S.kitId, S.sel) : step.choices;
    if(!choices) continue;
    // Auto-select single-choice steps
    if(choices.length === 1) {
      S.sel[step.key] = choices[0].val;
      changed = true;
      continue;
    }
    // Auto-select step with a declared default value
    if(step.defaultVal !== undefined && choices.some(c => c.val === step.defaultVal)) {
      S.sel[step.key] = step.defaultVal;
      changed = true;
      continue;
    }
    // Mirror front bumper selection to matching rear step
    if(step.mirror && S.sel[step.mirror] !== undefined) {
      const mirrorVal = S.sel[step.mirror];
      if(choices.some(c => c.val === mirrorVal)) {
        S.sel[step.key] = mirrorVal;
        changed = true;
        continue;
      }
    }
    // Pre-select step default value
    if(step.default !== undefined && choices.some(c => c.val === step.default)) {
      S.sel[step.key] = step.default;
      changed = true;
    }
  }
  return changed;
}

function render() {
  const platform = getActivePlatform();
  if(platform && S.kitId) {
    let changed = true;
    while(changed) changed = autoSelectSingleChoiceSteps(platform);
  }
  renderYMM();
  renderSteps();
  renderSummary();
}

function renderYMM() {
  const yrEl = document.getElementById('sel-year');
  yrEl.className = 'ymm-sel'+(S.year?' filled':'');
  const mkEl = document.getElementById('sel-make');
  mkEl.value = S.make;
  mkEl.className = 'ymm-sel'+(S.make?' filled':'');
  const mdEl = document.getElementById('sel-model');
  mdEl.value = S.model;
  mdEl.className = 'ymm-sel'+(S.model?' filled':'');
}

function renderSteps() {
  const container = document.getElementById('steps-container');
  container.innerHTML = '';

  const platform = getActivePlatform();
  if(!platform) {
    if(S.year&&S.make&&!S.platformId) {
      container.innerHTML = '<div style="color:var(--dim);font-size:13px;padding:12px 0">Select a model above to continue.</div>';
    }
    return;
  }

  // ── Kit selection (if more than one kit across all platforms for this model) ──
  const allModelKits = getAllKitsForModel();
  if(allModelKits.length > 1) {
    const kitCard = document.createElement('div');
    kitCard.className = 'step-card'+(S.kitId?' done':'');
    kitCard.innerHTML = `
      <div class="step-hd">
        <div class="step-num">${S.kitId?'✓':'1'}</div>
        <div class="step-title">Suspension System / Lift Height</div>
        <span class="step-badge req">Required</span>
        ${S.kitId?`<span class="step-preview">${getActiveKit()?.label||''}</span>`:''}
      </div>
      <div class="step-body">
        <div class="kit-grid">
          ${allModelKits.map(({kit:k})=>`
            <div class="kit-card${S.kitId===k.id?' active':''}" onclick="selectKit('${k.id}')">
              <div class="kit-card-label">${k.label}</div>
              <div class="kit-card-sub">${k.sub||''}</div>
            </div>
          `).join('')}
        </div>
      </div>`;
    container.appendChild(kitCard);
  }

  if(!S.kitId) return;

  // ── Dynamic steps ──
  let stepNum = allModelKits.length > 1 ? 2 : 1;

  for(const step of platform.steps) {
    // Evaluate condition
    const conditionFn = step.condition;
    const isVisible = conditionFn ? conditionFn(S.sel, S.kitId) : true;
    if(!isVisible) continue;

    const val = S.sel[step.key];
    const isMulti = !!step.multi;
    const picked = isMulti ? (Array.isArray(val) ? val : []) : null;
    const isDone = isMulti ? picked.length > 0 : val !== undefined;
    const choices = typeof step.choices === 'function'
      ? step.choices(S.kitId, S.sel)
      : step.choices;

    // Need prior required steps done
    const idx = platform.steps.indexOf(step);
    const prevRequired = platform.steps.slice(0, idx).filter(s=>{
      const cond = s.condition ? s.condition(S.sel, S.kitId) : true;
      return cond && s.badge==='req';
    });
    const prevDone = prevRequired.every(s=>S.sel[s.key]!==undefined);
    const isLocked = false; // build & price — every step visible from the start

    const card = document.createElement('div');
    card.className = `step-card${isLocked?' locked':''}${isDone?' done':''}`;

    const previewText = isMulti
      ? (picked.length ? (picked.length === (choices||[]).length
          ? 'All options' : `${picked.length} selected`) : '')
      : (choices?.find(c=>c.val===val)?.label || '');

    card.innerHTML = `
      <div class="step-hd">
        <div class="step-num">${isDone?'✓':stepNum}</div>
        <div class="step-title">${step.label}</div>
        <span class="step-badge ${step.badge||'opt'}">${step.badge==='req'?'Required':'Optional'}</span>
        ${isDone&&previewText?`<span class="step-preview">${previewText}</span>`:''}
      </div>
      <div class="step-body">
        ${step.hint?`<div class="step-hint">${step.hint}</div>`:''}
        ${isMulti?`<div class="rc-multibar">
          <button type="button" class="rc-mini" onclick="selectAllSteps('${step.key}')">Select all</button>
          <button type="button" class="rc-mini" onclick="clearStep('${step.key}')">Clear</button>
        </div>`:''}
        <div class="rc-group">
          ${(() => {
            // price every choice up front so the list can run lowest to highest
            const isMultiStep = !!step.multi;
            const priced = (choices||[]).map(c=>{
              let cp = (c.parts||[]).reduce((s,p)=>s+price(p.pn)*p.qty,0), ap = 0;
              if(S.kitId){
                try {
                  const pW = platform.buildParts(S.kitId, {...S.sel, [step.key]: c.val});
                  const pO = platform.buildParts(S.kitId, {...S.sel, [step.key]: undefined});
                  const cpns = new Set((c.parts||[]).map(p=>p.pn));
                  const w={}, o={};
                  pW.forEach(p=>{ w[p.pn]=(w[p.pn]||0)+p.qty; });
                  pO.forEach(p=>{ o[p.pn]=(o[p.pn]||0)+p.qty; });
                  const isL = pn => pn.startsWith('LBR-')||pn.startsWith('SVC-')||pn==='HYP-730125';
                  ap = Object.keys(w).filter(pn=>!cpns.has(pn)&&(w[pn]||0)>(o[pn]||0))
                        .reduce((s,pn)=> s + ((step.key!=='install'&&isL(pn))?0:price(pn)*(w[pn]-(o[pn]||0))), 0);
                } catch(e){}
              }
              return {c, sortAmt: cp+ap};
            });
            priced.sort((a,b)=>a.sortAmt-b.sortAmt);
            return priced.map(({c})=>{
            const choicePrice = (c.parts||[]).reduce((s,p)=>s+price(p.pn)*p.qty,0);
            const pnList = (c.parts||[]).map(p=>`${p.pn}${p.qty>1?' ×'+p.qty:''}`).join(' · ');
            let autoPnList = ''; let autoPrice = 0;
            if(S.kitId) {
              try {
                const selWith    = {...S.sel, [step.key]: c.val};
                const selWithout = {...S.sel, [step.key]: undefined};
                const pWith    = platform.buildParts(S.kitId, selWith);
                const pWithout = platform.buildParts(S.kitId, selWithout);
                const choicePns = new Set((c.parts||[]).map(p=>p.pn));
                // Use net quantity diff so same-P/N additions (e.g. same hook on front+rear) are counted correctly
                const withQty = {}, withoutQty = {};
                pWith.forEach(p=>{ withQty[p.pn]=(withQty[p.pn]||0)+p.qty; });
                pWithout.forEach(p=>{ withoutQty[p.pn]=(withoutQty[p.pn]||0)+p.qty; });
                const auto = Object.keys(withQty)
                  .filter(pn=>!choicePns.has(pn)&&(withQty[pn]||0)>(withoutQty[pn]||0))
                  .map(pn=>({pn,qty:withQty[pn]-(withoutQty[pn]||0)}));
                autoPnList = auto.map(p=>`${p.pn}${p.qty>1?' ×'+p.qty:''}`).join(' · ');
                // labor is priced on the Installation row only, never absorbed
                // into whichever option happens to trigger it first
                const isLbr = pn => pn.startsWith('LBR-') || pn.startsWith('SVC-') || pn==='HYP-730125';
                autoPrice = auto.reduce((s,p)=>
                  s + ((step.key!=='install' && isLbr(p.pn)) ? 0 : price(p.pn)*p.qty), 0);
              } catch(e){}
            }
            const rowTotal = choicePrice + autoPrice;
            // Suppress c.sub when autoPnList already shows the P/N info (avoids double display)
            const showSub = c.sub && !autoPnList;
            const isOn = isMultiStep ? (Array.isArray(val)&&val.includes(c.val)) : (val===c.val);
            return `<label class="rc${isOn?' active':''}">
              <input type="${isMultiStep?'checkbox':'radio'}" name="step-${step.key}" value="${c.val}"
                onchange="${isMultiStep?`toggleStep('${step.key}','${c.val}')`:`selectStep('${step.key}','${c.val}')`}"
                ${isOn?'checked':''}>
              <div class="rc-main">
                <div class="rc-label">${c.label}</div>
                ${showSub?`<div class="rc-sub">${c.sub}</div>`:''}
                ${pnList?`<div class="rc-pns">${pnList}</div>`:''}
                ${autoPnList?`<div class="rc-pns">${autoPnList}</div>`:''}
              </div>
              <div class="rc-amt">${rowTotal>0?fmtU(rowTotal):'<span class="rc-amt-inc">Included</span>'}</div>
            </label>`;
          }).join('');
          })()}
        </div>
      </div>`;

    container.appendChild(card);
    stepNum++;
  }
}

function displayRef() { return _buildName || _buildRef; }

function setDiscount(val) {
  val = 0; // retail tool — discounts disabled
  const n = parseFloat(val);
  _dealerDiscount = (!isNaN(n) && n >= 0 && n <= 100) ? n : 0;
  // Sync button active states
  document.querySelectorAll('.disc-btn').forEach(b=>{
    b.classList.toggle('active', parseFloat(b.dataset.disc||0)===_dealerDiscount);
  });
  const dr = document.getElementById('sum-dealer-row');
  if(!dr) return;
  if(_dealerDiscount > 0) {
    dr.style.display = '';
    const dp = document.getElementById('sum-dealer-price');
    if(dp) dp.textContent = fmtU(_lastTotal * (1 - _dealerDiscount/100));
    const dl = document.getElementById('sum-dealer-lbl');
    if(dl) dl.textContent = `Dealer Price (${_dealerDiscount}% off MSRP)`;
  } else {
    dr.style.display = 'none';
  }
  const hdr = document.getElementById('sum-discount-hdr-lbl');
  if(hdr) hdr.textContent = 'Dealer Discount' + (_dealerDiscount > 0 ? ` (${_dealerDiscount}% off)` : '');
}

function renderSummary() {
  if (_laborAuto) applySuggestedLabor();   // keep suggested hours in step with the build
  const bodyEl = document.getElementById('summary-body');
  const vehicleEl = document.getElementById('sum-vehicle');
  const badgeEl = document.getElementById('build-badge');
  const refInput = document.getElementById('build-ref-input');

  const platform = getActivePlatform();
  const kit = getActiveKit();

  if(!platform||!kit) {
    vehicleEl.textContent = '';
    badgeEl.style.display = 'none';
    const cb = document.getElementById('copy-link-btn'); if(cb) cb.style.display = 'none';
    bodyEl.innerHTML = '<div class="sum-empty">Select your vehicle above to begin building your quote.</div>';
    return;
  }

  // Assemble parts — show whatever buildParts returns based on current selections
  const allParts = platform.buildParts(S.kitId, S.sel);

  // Only gate on pending required steps if nothing can be shown yet
  if(!allParts.length) {
    vehicleEl.textContent = `${S.year} ${S.make} ${platform.label}`;
    badgeEl.style.display = 'none';
    const hasPendingRequired = platform.steps.some(step => {
      if(step.badge !== 'req') return false;
      const visible = step.condition ? step.condition(S.sel, S.kitId) : true;
      if(!visible) return false;
      return S.sel[step.key] === undefined;
    });
    bodyEl.innerHTML = `<div class="sum-empty">${hasPendingRequired ? 'Complete your selections above to see your quote.' : 'Make selections to build your parts list.'}</div>`;
    return;
  }

  // Consolidate duplicate P/Ns (e.g. same hook or light on front + rear → combine qty)
  const pnMap = {};
  for(const item of allParts) {
    if(pnMap[item.pn]) { pnMap[item.pn].qty += item.qty; }
    else { pnMap[item.pn] = {...item}; }
  }

  // Group by section
  const sections = {};
  for(const item of Object.values(pnMap)) {
    if(!sections[item.section]) sections[item.section]=[];
    sections[item.section].push(item);
  }

  // Canonical section display order — suspension first, bumper accessories last
  const SECTION_ORDER = [
    'Bed','Front Suspension','Rear Suspension','Cradle Center','Lift Spacers','Radius Arms',
    'Steering Stabilizer','Air Controls','Shocks','Shocks (Included)',
    'Front Bumper','Rear Bumper','Winch',
    'Grille Guard','Grille Guard Lights','Bumper Lights','Accessories','Hooks',
    'Fender Flares','Wheels & Tires','Headache Rack','Fuel','Finish','Paint','Calibration',
  ];
  const sortedSections = Object.entries(sections).sort(([a],[b])=>{
    const ai=SECTION_ORDER.indexOf(a), bi=SECTION_ORDER.indexOf(b);
    if(ai===-1&&bi===-1) return 0;
    if(ai===-1) return 1;
    if(bi===-1) return -1;
    return ai-bi;
  });

  // Collect skipped optional steps
  const skippedOpt = platform.steps.filter(step => {
    if(step.badge !== 'opt') return false;
    const visible = step.condition ? step.condition(S.sel, S.kitId) : true;
    if(!visible) return false;
    return S.sel[step.key] === undefined;
  });

  let total = 0;
  let html = '';
  for(const [sec, items] of sortedSections) {
    html += `<div class="sum-sec"><div class="sum-sec-lbl">${sec}</div>`;
    for(const item of items) {
      const partInfo = P[item.pn]||{desc:item.pn,msrp:0};
      const lineTotal = partInfo.msrp * item.qty;
      total += lineTotal;
      html += `<div class="sum-row">
        <span class="s-pn">${item.pn}${item.qty>1?' ×'+item.qty:''}<button class="copy-pn-btn" onclick="copyPn(this,'${item.pn}')" title="Copy part number"><svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor"><path d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z"/></svg></button></span>
        <span class="s-desc">${partInfo.desc}</span>
        <span class="s-price">${fmt(lineTotal)}</span>
      </div>`;
    }
    html += '</div>';
  }

  if(skippedOpt.length) {
    html += `<div class="sum-sec sum-sec-skipped"><div class="sum-sec-lbl">Optional — Not Selected</div>`;
    for(const step of skippedOpt) {
      html += `<div class="sum-row sum-row-skipped">
        <span class="s-pn" style="color:var(--gold)">—</span>
        <span class="s-desc">${step.label}</span>
        <span class="s-price" style="color:var(--dim)">N/A</span>
      </div>`;
    }
    html += '</div>';
  }

  // Finish notes — finish choices don't affect P/Ns; must be called out at ordering
  const finishLabels = {'bare-steel':'Bare Steel / No Powder Coat','primer':'Primer Powder Coat','textured-black':'Textured Black Powder Coat','gloss-black':'Gloss Black Powder Coat','gloss-red':'Gloss Red Powder Coat'};
  // Suspension finish note
  const hasSuspParts = allParts.some(p=>['Front Suspension','Rear Suspension','Lift Spacers','Radius Arms','Steering Stabilizer','Air Controls','Shocks','Shocks (Included)','Cradle Center'].includes(p.section));
  if(hasSuspParts) {
    const sf = finishLabels[S.sel['susp-finish']];
    if(sf) html += `<div class="sum-finish-note">⚠ Suspension Finish: <strong>${sf}</strong> — finish does not affect part number and must be specified when ordering.</div>`;
  }
  // Bumper finish note
  const isBumperBuild = allParts.some(p=>p.section==='Front Bumper'||p.section==='Rear Bumper');
  if(isBumperBuild) {
    const frontFinish = finishLabels[S.sel['front-finish']];
    const rearFinish  = finishLabels[S.sel['rear-pu-finish']||S.sel['rear-cc-finish']];
    const hasFront = allParts.some(p=>p.section==='Front Bumper');
    const hasRear  = allParts.some(p=>p.section==='Rear Bumper');
    let finishNote = '';
    if(hasFront && hasRear && frontFinish && rearFinish && frontFinish !== rearFinish)
      finishNote = `Front: ${frontFinish} &nbsp;|&nbsp; Rear: ${rearFinish}`;
