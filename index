// RESET
// ═══════════════════════════════════════════════════════════════
function resetAll() {
  S = { year:'', make:'', model:'', platformId:'', kitId:'', sel:{} };
  _buildRef = buildRef();
  _buildName = '';
  _dealerDiscount = 0;
  _laborHours = 0;
  _laborAuto = true;
  _laborExpanded = false;
  _taxExpanded = false;
  _discountExpanded = false;
  history.replaceState(null,'',window.location.pathname);

  document.getElementById('sel-year').value = '';
  populateMakes();
  populateModels();
  render();
}

// ═══════════════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════════════
(async function init() {
  try {
    const yrEl = document.getElementById('sel-year');
    const yrs = getYears();
    if (!yrs || yrs.length === 0) {
      const o = document.createElement('option');
      o.value = ''; o.textContent = 'Error: no years found (CATALOG=' + (typeof CATALOG !== 'undefined' ? CATALOG.length : 'undef') + ')';
      yrEl.appendChild(o);
    } else {
      yrs.forEach(y => {
        const o = document.createElement('option');
        o.value = o.textContent = y;
        yrEl.appendChild(o);
      });
    }
    await decodeBuildFromURL();
    render();
    // Auto-apply mobile view on real phones — runs last so DOM is fully settled
    try { if(window.innerWidth < 640) setView('mobile'); } catch(e) {}
    // Belt-and-suspenders event listeners for iOS Safari (inline onchange can be unreliable)
    document.getElementById('sel-year').addEventListener('change', onYear);
    document.getElementById('sel-make').addEventListener('change', onMake);
    document.getElementById('sel-model').addEventListener('change', onModel);
  } catch(err) {
    // Show error in year select so we can diagnose on iOS without DevTools
    try {
      const yrEl = document.getElementById('sel-year');
      const o = document.createElement('option');
      o.value = ''; o.textContent = 'JS Error: ' + err.message;
      yrEl.appendChild(o);
    } catch(e2) {}
  }
})();
</script>
