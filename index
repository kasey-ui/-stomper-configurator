    buildParts:(kit,sel)=>{
      const parts=[];
      const s=sel.scope;
      const isBoth=s==='both';
      if(s!=='rear-only'){
        if(sel.drive==='2wd') parts.push({section:'Front Suspension',pn:'KLM50810',qty:1});
        if(sel.drive==='4wd') parts.push({section:'Front Suspension',pn:'KLM11175',qty:1});
      }
      if(sel.rear==='round-11k')  parts.push({section:'Rear Suspension',pn:'KLM16680',qty:1});
