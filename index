            {val:'slkd',      label:'Mechanical Self-Leveling — Single Compressor (SLKD2WD)',
             sub:'Viair compressor, 3-gal tank, pressure switch, relay, (2) height control valves, (2) dump valves, air dryer, control panel',
             parts:[{pn:'SLKD2WD',qty:1}]},
            {val:'dual-mech', label:'Mechanical Self-Leveling — Dual Compressor (30664)',
