           {val:'none',     label:'No Controls — Manual Fill',sub:'Fill via shop air — no compressor or automation'},
           {val:'slkd2wd',  label:'Mechanical Self-Leveling — Single Compressor (SLKD2WD)',
            sub:isBoth?'SLKD2WD + (2) HCVLK':'SLKD2WD — Viair compressor, 3-gal tank, HCV valves, dump valves, air dryer, panel',
            parts:isBoth?[{pn:'SLKD2WD',qty:1},{pn:'HCVLK',qty:2}]:[{pn:'SLKD2WD',qty:1}]},
           {val:'dual-mech',label:'Mechanical Self-Leveling — Dual Compressor (30664)',
