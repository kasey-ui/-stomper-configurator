        if(sel.dss==='dss') parts.push({section:'Steering Stabilizer',pn:'10008606',qty:1});
        if(sel.scope!=='front-only') {
          if(sel.height==='7') {
            parts.push({section:'Rear Suspension',pn:'10006053',qty:1});
