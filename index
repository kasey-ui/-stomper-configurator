// ── Programmatic P/N population — 2023+ Ford Super Duty Bumpers ─────────────
(function() {
  const sdModels = {
    '402021023': {label:'F-250', hasStock:true},
    '402022023': {label:'F-350', hasStock:true},
    '402023023': {label:'F-450', hasStock:false},
    '402024023': {label:'F-550', hasStock:false},
    '402032023': {label:'F-600', hasStock:false},
  };
  const parkDescs  = {'001':'Adaptive Cruise + Parking Sensors', '002':'No Parking Sensors'};
  const seriesDescs= {'02':'Alpha Series (Winch Center)', '04':'Delta Series'};
  const endCapDescs= {'0000':'Stock Width','1200':'1.25" Wide End Caps','3500':'3.5" Wide End Caps (ER Fender Flares)'};
  const rearParkDescs = {'101':'w/ Parking Sensors','102':'No Parking Sensors'};
  const ccSuffixDescs = {
    '108039000':'Bravo Series, Smooth Face — Sherptek Flatbed DRW 94"',
    '108039001':'Bravo Series, Clevis Ears — Sherptek Flatbed DRW 94"',
    '108040000':'Delta Series, Stock Width — Custom 2023+ Pickup Box Conversion',
  };
  Object.entries(sdModels).forEach(([base,{label,hasStock}])=>{
    // Front bumpers
    // 3.5" (ER Fender Flare) end caps exist on both '001' (ACC+sensors) and '002' (no sensors) variants
    ['001','002'].forEach(park=>{
      ['02','04'].forEach(series=>{
        const baseEcs = hasStock ? ['0000','1200'] : ['1200'];
        const endcaps = [...baseEcs,'3500'];
        endcaps.forEach(ec=>{
          const pn = `KLM-${base}-${park}${series}${ec}`;
          P[pn] = {desc:`2023+ Ford ${label} Front Bumper — ${seriesDescs[series]}, ${parkDescs[park]}, ${endCapDescs[ec]}`, msrp:2750};
        });
      });
    });
    // Rear bumpers — pickup (F-250/F-350/F-450)
    if(['402021023','402022023','402023023'].includes(base)){
      ['101','102'].forEach(rp=>{
        const pn = `KLM-${base}-${rp}040000`;
        P[pn] = {desc:`2023+ Ford ${label} Rear Bumper — Delta Series, ${rearParkDescs[rp]}, Stock Width`, msrp:2250};
      });
    }
    // Rear bumpers — CC (F-450/F-550/F-600)
    if(['402023023','402024023','402032023'].includes(base)){
      Object.entries(ccSuffixDescs).forEach(([suf,sdesc])=>{
        const pn = `KLM-${base}-${suf}`;
        P[pn] = {desc:`2023+ Ford ${label} Cab Chassis Rear Bumper — ${sdesc}`, msrp:2250};
      });
    }
  });
})();

// Returns manual-fill line kit parts for the summary.
// hasFront: front air suspension is included; hasRear: rear is included
// ccRear: rear is a CC 4-link (not pickup); is2Stage: rear is 2-stage
function mfLine(hasFront, hasRear, ccRear, is2Stage) {
  const ps = [];
  if (hasFront) ps.push({section:'Air Controls', pn:'51773', qty:1});
  if (hasRear) {
    if (is2Stage)    ps.push({section:'Air Controls', pn:'51775', qty:1});
    else if (ccRear) ps.push({section:'Air Controls', pn:'51774', qty:1});
    else             ps.push({section:'Air Controls', pn:'51773', qty:1});
  }
  return ps;
}

// ── 2023+ Ford Super Duty Bumper Platform Generator ──────────────────────────
// rearType: 'pickup' | 'cc' | 'both'
function fordSDBumper(id, yr_from, yr_to, make, model, label, modelBase, hasStockWidth, rearType) {
  // Shared hook choices (qty 2 per bumper)
  const hookChoices = [
    {val:'none',    label:'No Hooks'},
    {val:'sw1b',    label:'Monster Hooks Swivel Hook — Satin Black (+$500)',         sub:'MH-SW1B × 2',   parts:[{pn:'MH-SW1B',qty:2}]},
    {val:'sw1c',    label:'Monster Hooks Swivel Hook — Chrome Plated (+$600)',        sub:'MH-SW1C × 2',   parts:[{pn:'MH-SW1C',qty:2}]},
    {val:'sw1s',    label:'Monster Hooks Swivel Hook — Silver Powder Coat (+$500)',   sub:'MH-SW1S × 2',   parts:[{pn:'MH-SW1S',qty:2}]},
    {val:'sw1a',    label:'Monster Hooks Swivel Hook — Raw Aluminum (+$500)',         sub:'MH-SW1A × 2',   parts:[{pn:'MH-SW1A',qty:2}]},
    {val:'sw1r',    label:'Monster Hooks Swivel Hook — Candy Red (+$500)',            sub:'MH-SW1R × 2',   parts:[{pn:'MH-SW1R',qty:2}]},
    {val:'rs78xlb', label:'Monster Hooks Reaper Hook (+$350)',                        sub:'MH-RS78XLB × 2',parts:[{pn:'MH-RS78XLB',qty:2}]},
  ];
  const wingLightChoices = (qty)=>[
    {val:'none',          label:`No Lights — Cutout${qty>1?'s':''} Included`},
    {val:'flood',         label:`(${qty}) 4" Rigid E-Series Flood (+$${qty*310})`,         sub:`RIG104113 × ${qty}`, parts:[{pn:'RIG104113',qty}]},
    {val:'spot',          label:`(${qty}) 4" Rigid E-Series Spot (+$${qty*310})`,          sub:`RIG104213 × ${qty}`, parts:[{pn:'RIG104213',qty}]},
    {val:'midnight-spot', label:`(${qty}) 4" Rigid E-Series Midnight Spot (+$${qty*310})`, sub:`RIG104213BLK × ${qty}`,parts:[{pn:'RIG104213BLK',qty}]},
  ];
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];
  const srLightChoices = (qty)=>[
    {val:'none',       label:'No Light Bars — Cutouts Included'},
    {val:'sr-midnight',label:`20" SR-Series Midnight Edition PRO — Hybrid/Spot (+$${qty*670})`,    sub:`RIG920214BLK × ${qty}`,parts:[{pn:'RIG920214BLK',qty}]},
    {val:'sr-combo',   label:`20" SR-Series PRO — Spot/Flood Combo (+$${qty*670})`,                sub:`RIG920314 × ${qty}`,    parts:[{pn:'RIG920314',qty}]},
    {val:'sr-driving', label:`20" SR-Series PRO — Spot/Driving Combo (+$${qty*780})`,              sub:`RIG921314 × ${qty}`,    parts:[{pn:'RIG921314',qty}]},
  ];

  // 3.5" ER Fender Flare end caps only exist on No-Parking-Sensors variants
  const endCapChoices = (sel) => {
    const opts = hasStockWidth
      ? [{val:'stock', label:'Stock Width'}, {val:'wide-125', label:'1.25" Wide End Caps'}]
      : [{val:'wide-125', label:'1.25" Wide End Caps'}];
    opts.push({val:'wide-350', label:'3.5" Wide End Caps — ER Fender Flares'});
    return opts;
  };

  const parkCode  = {with:'001', without:'002'};
  const seriesCode= {'alpha-winch':'02', 'alpha-light':null/*TBD — P/N code needed*/, delta:'04', bravo:null/*TBD — P/N code needed*/};
  const ecCode    = {stock:'0000','wide-125':'1200','wide-350':'3500'};

  // Helper: grille guard P/N lookup
  const ggPN = (config, clevis) => {
    const cv = clevis ? '1' : '0';
    if(config==='sq-solid')  return `KLM-202021023-0111100000${cv}`;
    if(config==='sq-lights') return `KLM-202021023-0212100000${cv}`;
    if(config==='headlight') return 'KLM-202021023-11903030001'; // always clevis
    return null;
  };

  const steps = [
    // ── Bumper Position ────────────────────────────────────────
    {key:'bumper-position', label:'Bumper Position', badge:'req',
     condition:()=>true,
     choices:()=>{
       const opts = [{val:'front', label:'Front Bumper Only'}];
       if(rearType==='pickup'||rearType==='both'){
         opts.push({val:'rear-pu',       label:'Rear Bumper Only — Pickup'});
         opts.push({val:'front-rear-pu', label:'Front + Rear Bumper — Pickup'});
       }
       if(rearType==='cc'||rearType==='both'){
         opts.push({val:'rear-cc',       label:'Rear Bumper Only — Chassis Cab'});
         opts.push({val:'front-rear-cc', label:'Front + Rear Bumper — Chassis Cab'});
       }
       return opts;
     },
    },

    // ══════════════════════════════════════════════════════════
    // FRONT BUMPER — Kelderman Manufactured
    // ══════════════════════════════════════════════════════════
    {key:'front-series', label:'Front Bumper Series', badge:'req',
     condition:(sel)=>['front','front-rear-pu','front-rear-cc'].includes(sel['bumper-position']),
     choices:()=>[
       {val:'alpha-winch', label:'Alpha Series — Winch Center',  sub:'Winch-ready center mount — can add Commander Grille Guard'},
       {val:'alpha-light', label:'Alpha Series — Light Center',  sub:'20" light bar cutout — can add Commander Grille Guard'},
       {val:'delta',       label:'Delta Series — Light Center',  sub:'Center section with 20" light bar cutout'},
       {val:'bravo',       label:'Bravo Series — Light Center',  sub:'Center section with 20" light bar cutout'},
     ],
    },
    // Center section — Winch (Alpha Winch only)
    {key:'front-center-winch', label:'Center Section — Winch', badge:'opt',
     condition:(sel)=>sel['front-series']==='alpha-winch',
     choices:()=>[
       {val:'none',     label:'No Winch — Winch Cutout Included'},
       {val:'war97740', label:'Warn 16.5ti — Hawse Fairlead, Synthetic Rope (+$3,350)', sub:'WAR97740', parts:[{pn:'WAR97740',qty:1}]},
       {val:'war68801', label:'Warn 16.5ti — Roller Fairlead, Steel Cable (+$3,015)',   sub:'WAR68801', parts:[{pn:'WAR68801',qty:1}]},
     ],
    },
    // Center section — Light Bar (Alpha Light / Delta / Bravo)
    {key:'front-center-light', label:'Center Section — Light Bar', badge:'opt',
     condition:(sel)=>['alpha-light','delta','bravo'].includes(sel['front-series']),
     choices:()=>[
       {val:'none',       label:'No Light Bar — Light Bar Cutout Included'},
       {val:'e-series',   label:'20" Rigid E-Series Spot/Flood Combo (+$860)',        sub:'RIG120313',    parts:[{pn:'RIG120313',   qty:1}]},
       {val:'e-midnight', label:'20" Rigid E-Series Midnight Edition Spot (+$860)',    sub:'RIG120213BLK', parts:[{pn:'RIG120213BLK',qty:1}]},
     ],
    },
    {key:'front-parking', label:'Parking Sensors', badge:'req',
     condition:(sel)=>{
       const s = sel['front-series'];
       if(!s) return false;
       if(s==='alpha-winch') return !!sel['front-center-winch'];
       return !!sel['front-center-light'];
     },
     choices:()=>[
       {val:'with',    label:'With Adaptive Cruise + Parking Sensors'},
       {val:'without', label:'No Parking Sensors'},
     ],
    },
    {key:'front-endcap', label:'End Cap Width', badge:'req',
     condition:(sel)=>!!sel['front-parking'],
     choices:(kit,sel)=>endCapChoices(sel),
    },
    {key:'front-finish', label:'Bumper Finish', badge:'req',
     condition:(sel)=>!!sel['front-endcap'],
     choices:()=>finishChoices,
    },

    // ══════════════════════════════════════════════════════════
    // REAR BUMPER — Kelderman Manufactured
    // ══════════════════════════════════════════════════════════
    // — Pickup path —
    {key:'rear-pu-series', label:'Rear Bumper Series', badge:'req',
     condition:(sel)=>{
       if(!['rear-pu','front-rear-pu'].includes(sel['bumper-position'])) return false;
       if(sel['bumper-position']==='front-rear-pu') return !!sel['front-finish'];
       return true;
     },
     choices:()=>[
       {val:'delta', label:'Delta Series', sub:'Stock width rear bumper'},
     ],
    },
    {key:'rear-pu-parking', label:'Rear Parking Sensors', badge:'req',
     condition:(sel)=>!!sel['rear-pu-series'],
     choices:()=>[
       {val:'with',    label:'With Parking Sensors'},
       {val:'without', label:'No Parking Sensors'},
     ],
    },
    {key:'rear-pu-finish', label:'Rear Bumper Finish', badge:'req',
     mirror:'front-finish',
     condition:(sel)=>!!sel['rear-pu-parking'],
     choices:()=>finishChoices,
    },
    // — Chassis Cab path —
    {key:'rear-cc-series', label:'Rear Bumper Series', badge:'req',
     condition:(sel)=>{
       if(!['rear-cc','front-rear-cc'].includes(sel['bumper-position'])) return false;
       if(sel['bumper-position']==='front-rear-cc') return !!sel['front-finish'];
       return true;
     },
     choices:()=>[
       {val:'bravo', label:'Bravo Series', sub:'Sherptek Flatbed DRW 94" — Smooth Face or Clevis Ears'},
       {val:'delta', label:'Delta Series', sub:'Stock Width — Custom 2023+ Pickup Box Conversion'},
     ],
    },
    {key:'rear-cc-face', label:'Face Style', badge:'req',
     condition:(sel)=>sel['rear-cc-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Ears'},
     ],
    },
    {key:'rear-cc-finish', label:'Rear Bumper Finish', badge:'req',
     mirror:'front-finish',
     condition:(sel)=>!!sel['rear-cc-series'],
     choices:()=>finishChoices,
    },

    // ══════════════════════════════════════════════════════════
    // GRILLE GUARD — Kelderman Manufactured
    // ══════════════════════════════════════════════════════════
    {key:'gg-config', label:'Commander Grille Guard', badge:'opt',
     condition:(sel)=>{
       if(!['alpha-winch','alpha-light'].includes(sel['front-series'])||!sel['front-finish']) return false;
       if(sel['bumper-position']==='front-rear-pu'&&!sel['rear-pu-finish']) return false;
       if(sel['bumper-position']==='front-rear-cc'&&!sel['rear-cc-finish']) return false;
       return true;
     },
     choices:()=>[
       {val:'none',      label:'No Grille Guard'},
       {val:'sq-solid',  label:'Commander Grille Guard — Square × 2 Crossbars, No Light Cutouts (+$1,050–$1,100)', sub:'KLM-202021023-01111000...'},
       {val:'sq-lights', label:'Commander Grille Guard — Square × 2 Crossbars with Light Bar Cutouts (+$1,100)',    sub:'KLM-202021023-02121000...'},
       {val:'headlight', label:'Commander Grille Guard + Headlight Guard — 30" 360-Connect Center (+$1,400)',        sub:'KLM-202021023-11903030001 — Always w/ Clevis Ears'},
     ],
    },
    {key:'gg-clevis', label:'Grille Guard Hook Mounts', badge:'req',
     condition:(sel)=>sel['gg-config']==='sq-solid'||sel['gg-config']==='sq-lights',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the grille guard'},
     ],
    },

    // ══════════════════════════════════════════════════════════
    // ACCESSORIES — Kelderman Manufactured
    // ══════════════════════════════════════════════════════════
    {key:'front-lp', label:'License Plate Bracket', badge:'opt',
     condition:(sel)=>{
       const hasFront = ['front','front-rear-pu','front-rear-cc'].includes(sel['bumper-position']);
       if(!hasFront||!sel['front-finish']) return false;
       if(['alpha-winch','alpha-light'].includes(sel['front-series'])){
         if(!sel['gg-config']) return false;
         if((sel['gg-config']==='sq-solid'||sel['gg-config']==='sq-lights')&&!sel['gg-clevis']) return false;
         return true;
       }
       if(sel['bumper-position']==='front-rear-pu'&&!sel['rear-pu-finish']) return false;
       if(sel['bumper-position']==='front-rear-cc'&&!sel['rear-cc-finish']) return false;
       return true;
     },
     choices:()=>[
       {val:'no',  label:'No License Plate Bracket'},
       {val:'yes', label:'Yes — Add License Plate Bracket', sub:'31910 — Honeycomb Mesh, No Charge', parts:[{pn:'31910',qty:1}]},
     ],
    },

    // ══════════════════════════════════════════════════════════
    // PURCHASED ACCESSORIES — Warn / Rigid / Monster Hooks
    // ══════════════════════════════════════════════════════════
    // Front — Grille Guard Lights (sq-lights)
    {key:'gg-light-bars', label:'Grille Guard — Light Bars', badge:'opt',
     condition:(sel)=>sel['gg-config']==='sq-lights'&&!!sel['front-lp'],
     choices:()=>srLightChoices(2),
    },
    // Front — Headlight Guard Center Light
    {key:'gg-hl-light', label:'Headlight Guard — Center Light Bar', badge:'opt',
     condition:(sel)=>sel['gg-config']==='headlight'&&!!sel['front-lp'],
     choices:()=>[
       {val:'none',         label:'No Light Bar — 30" Structural Cutout Included'},
       {val:'360-connect',  label:'30" Rigid 360-Connect Light Bar (+$2,100)', sub:'RIG36306', parts:[{pn:'RIG36306',qty:1}]},
     ],
    },
    // Front — Outer Wing Lights
    {key:'front-wing-lights', label:'Outer Wing Lights', badge:'opt',
     condition:(sel)=>!!sel['front-lp'],
     choices:()=>wingLightChoices(4),
    },
    // Front — Hooks
    {key:'front-hooks', label:'Hooks', badge:'opt',
     condition:(sel)=>!!sel['front-lp']&&(
       !sel['gg-config']||
       sel['gg-config']==='none'||
       sel['gg-config']==='headlight'||
       sel['gg-clevis']==='clevis'
     ),
     choices:()=>hookChoices,
    },
    // Rear Pickup — Lights + Hooks
    {key:'rear-pu-lights', label:'Rear Bumper Lights', badge:'opt',
     mirror:'front-wing-lights',
     condition:(sel)=>!!sel['rear-pu-finish'],
     choices:()=>wingLightChoices(2),
    },
    {key:'rear-pu-hooks', label:'Rear Bumper Hooks', badge:'opt',
     mirror:'front-hooks',
     condition:(sel)=>!!sel['rear-pu-finish'],
     choices:()=>hookChoices,
    },
    // Rear CC — Lights + Hooks
    {key:'rear-cc-lights', label:'Rear Bumper Lights', badge:'opt',
     mirror:'front-wing-lights',
     condition:(sel)=>!!sel['rear-cc-finish'],
     choices:()=>wingLightChoices(2),
    },
    {key:'rear-cc-hooks', label:'Rear Bumper Hooks', badge:'opt',
     mirror:'front-hooks',
     condition:(sel)=>!!sel['rear-cc-finish']&&(sel['rear-cc-series']==='delta'||sel['rear-cc-face']==='clevis'),
     choices:()=>hookChoices,
    },
  ];

  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Front & rear bumpers with accessories'}],
    steps,
    buildParts:(kit,sel)=>{
      const parts=[];
      const hookPN = {
        sw1b:'MH-SW1B',sw1c:'MH-SW1C',sw1s:'MH-SW1S',
        sw1a:'MH-SW1A',sw1r:'MH-SW1R',rs78xlb:'MH-RS78XLB'
      };
      const wingPN = {flood:'RIG104113',spot:'RIG104213','midnight-spot':'RIG104213BLK'};

      const bp=sel['bumper-position']||'';
      // ── FRONT BUMPER ──────────────────────────────────────────
      if(['front','front-rear-pu','front-rear-cc'].includes(bp)){
        const pk = parkCode[sel['front-parking']];
        const sc = seriesCode[sel['front-series']];
        const ec = ecCode[sel['front-endcap']];
        if(pk&&sc&&ec) parts.push({section:'Front Bumper', pn:`KLM-${modelBase}-${pk}${sc}${ec}`, qty:1});

        // Grille guard
        const gg = sel['gg-config'];
        const clevis = gg==='headlight'||sel['gg-clevis']==='clevis';
        const ggpn = ggPN(gg, clevis);
        if(ggpn) parts.push({section:'Grille Guard', pn:ggpn, qty:1});

        // Grille guard lights
        if(gg==='sq-lights'){
          const p=wingPN[sel['gg-light-bars']] ? {pn:wingPN[sel['gg-light-bars']]} :
                  sel['gg-light-bars']==='sr-midnight' ? {pn:'RIG920214BLK'} :
                  sel['gg-light-bars']==='sr-combo'    ? {pn:'RIG920314'}    :
                  sel['gg-light-bars']==='sr-driving'  ? {pn:'RIG921314'}    : null;
          if(p&&p.pn&&sel['gg-light-bars']!=='none') parts.push({section:'Grille Guard Lights', pn:p.pn, qty:2});
        }
        if(gg==='headlight'&&sel['gg-hl-light']==='360-connect')
          parts.push({section:'Grille Guard Lights', pn:'RIG36306', qty:1});

        // Winch (Alpha Winch Center)
        if(sel['front-center-winch']==='war97740') parts.push({section:'Winch', pn:'WAR97740', qty:1});
        if(sel['front-center-winch']==='war68801') parts.push({section:'Winch', pn:'WAR68801', qty:1});

        // Center light bar (Alpha Light / Delta / Bravo)
        const dcMap = {'sr-midnight':'RIG920214BLK','sr-combo':'RIG920314','sr-driving':'RIG921314','e-series':'RIG120313','e-midnight':'RIG120213BLK'};
        if(dcMap[sel['front-center-light']]) parts.push({section:'Bumper Lights', pn:dcMap[sel['front-center-light']], qty:1});

        // Outer wing lights (qty 4)
        if(wingPN[sel['front-wing-lights']])
          parts.push({section:'Bumper Lights', pn:wingPN[sel['front-wing-lights']], qty:4});

        // License plate
        if(sel['front-lp']==='yes') parts.push({section:'Accessories', pn:'31910', qty:1});

        // Hooks + locking pins
        const fh = sel['front-hooks'];
        if(fh&&fh!=='none'&&hookPN[fh]){
          parts.push({section:'Hooks', pn:hookPN[fh], qty:2});
          if(gg&&gg!=='none') parts.push({section:'Hooks', pn:'61000', qty:2}); // locking pins for GG hooks
        }
      }

      // ── REAR BUMPER — PICKUP ──────────────────────────────────
      if(['rear-pu','front-rear-pu'].includes(bp)){
        const rp = sel['rear-pu-parking']==='with' ? '101' : '102';
        const rsc = {delta:'04'}[sel['rear-pu-series']]||'04';
        parts.push({section:'Rear Bumper', pn:`KLM-${modelBase}-${rp}${rsc}0000`, qty:1});
        if(wingPN[sel['rear-pu-lights']])
          parts.push({section:'Bumper Lights', pn:wingPN[sel['rear-pu-lights']], qty:2});
        const rph = sel['rear-pu-hooks'];
        if(rph&&rph!=='none'&&hookPN[rph]) parts.push({section:'Hooks', pn:hookPN[rph], qty:2});
      }

      // ── REAR BUMPER — CHASSIS CAB ─────────────────────────────
      if(['rear-cc','front-rear-cc'].includes(bp)){
        const ccSuf = sel['rear-cc-series']==='bravo'
          ? (sel['rear-cc-face']==='clevis' ? '108039001' : '108039000')
          : '108040000';
        parts.push({section:'Rear Bumper', pn:`KLM-${modelBase}-${ccSuf}`, qty:1});
        if(wingPN[sel['rear-cc-lights']])
          parts.push({section:'Bumper Lights', pn:wingPN[sel['rear-cc-lights']], qty:2});
        const rch = sel['rear-cc-hooks'];
        if(rch&&rch!=='none'&&hookPN[rch]) parts.push({section:'Hooks', pn:hookPN[rch], qty:2});
      }

      return parts;
    },
  };
}

// ── 2017-2022 Ford Super Duty Pickup Bumper Platform Generator ───────────────
// frontModelBase  : e.g. '402021017' — no-ACC (2017-2022) and ACC 2017-2019 share this base
// accModelBase2022: e.g. '402021020' — ACC 2020-2022 bumpers only
// ggModelBase     : e.g. '202021017'
// hasStockWidth   : true for F-250/F-350, false for F-450
function fordSD17Bumper(id, yr_from, yr_to, make, model, label, frontModelBase, accModelBase2022, ggModelBase, hasStockWidth) {
  const hookChoices = [
    {val:'none',    label:'No Hooks'},
    {val:'sw1b',    label:'Monster Hooks Swivel Hook — Satin Black (+$500)',         sub:'MH-SW1B × 2',    parts:[{pn:'MH-SW1B',qty:2}]},
    {val:'sw1c',    label:'Monster Hooks Swivel Hook — Chrome Plated (+$600)',        sub:'MH-SW1C × 2',    parts:[{pn:'MH-SW1C',qty:2}]},
    {val:'sw1s',    label:'Monster Hooks Swivel Hook — Silver Powder Coat (+$500)',   sub:'MH-SW1S × 2',    parts:[{pn:'MH-SW1S',qty:2}]},
    {val:'sw1a',    label:'Monster Hooks Swivel Hook — Raw Aluminum (+$500)',         sub:'MH-SW1A × 2',    parts:[{pn:'MH-SW1A',qty:2}]},
    {val:'sw1r',    label:'Monster Hooks Swivel Hook — Candy Red (+$500)',            sub:'MH-SW1R × 2',    parts:[{pn:'MH-SW1R',qty:2}]},
    {val:'rs78xlb', label:'Monster Hooks Reaper Hook (+$350)',                        sub:'MH-RS78XLB × 2', parts:[{pn:'MH-RS78XLB',qty:2}]},
  ];
  const wingLightChoices = (qty)=>[
    {val:'none',          label:`No Lights — Cutout${qty>1?'s':''} Included`},
    {val:'flood',         label:`(${qty}) 4" Rigid E-Series Flood (+$${qty*310})`,         sub:`RIG104113 × ${qty}`,    parts:[{pn:'RIG104113',qty}]},
    {val:'spot',          label:`(${qty}) 4" Rigid E-Series Spot (+$${qty*310})`,          sub:`RIG104213 × ${qty}`,    parts:[{pn:'RIG104213',qty}]},
    {val:'midnight-spot', label:`(${qty}) 4" Rigid E-Series Midnight Spot (+$${qty*310})`, sub:`RIG104213BLK × ${qty}`, parts:[{pn:'RIG104213BLK',qty}]},
  ];
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];
  const srLightChoices = (qty)=>[
    {val:'none',        label:'No Light Bars — Cutouts Included'},
    {val:'sr-midnight', label:`20" SR-Series Midnight Edition PRO — Hybrid/Spot (+$${qty*670})`, sub:`RIG920214BLK × ${qty}`, parts:[{pn:'RIG920214BLK',qty}]},
    {val:'sr-combo',    label:`20" SR-Series PRO — Spot/Flood Combo (+$${qty*670})`,             sub:`RIG920314 × ${qty}`,    parts:[{pn:'RIG920314',qty}]},
    {val:'sr-driving',  label:`20" SR-Series PRO — Spot/Driving Combo (+$${qty*780})`,           sub:`RIG921314 × ${qty}`,    parts:[{pn:'RIG921314',qty}]},
  ];

  const ecChoices = hasStockWidth
    ? [{val:'0000', label:'Stock Width'}, {val:'1500', label:'1.5" Wide End Caps'}]
    : [{val:'1500', label:'1.5" Wide End Caps'}];

  // P/N builders
  const frontPN = (acc, series, wide, clevis) => {
    const isACC = acc !== 'no-acc';
    const base  = acc === 'acc-2022' ? accModelBase2022 : frontModelBase;
    const pk    = isACC ? '001' : '002';
    const sfx   = (isACC || series === 'delta') ? '' : '-02';
    if(series==='alpha-light') return `KLM-${base}-${pk}01${wide}${sfx}`;
    if(series==='alpha-winch') return `KLM-${base}-${pk}02${wide}${sfx}`;
    if(series==='bravo') {
      const w3 = wide==='1500' ? '150' : '000';
      const cv = clevis ? '1' : '0';
      return `KLM-${base}-${pk}03${w3}${cv}${sfx}`;
    }
    if(series==='delta') return `KLM-${base}-${pk}04${wide}`;
    return null;
  };
  const rearPN = (sensors, series, clevis) => {
    const sc  = sensors==='with' ? '101' : '102';
    const sfx = sensors==='with' ? '-02' : '';
    if(series==='alpha') return `KLM-${frontModelBase}-${sc}000000-02`;
    const cv = clevis ? '1' : '0';
    return `KLM-${frontModelBase}-${sc}03000${cv}${sfx}`;
  };
  const ggPN17 = (config, clevis) => {
    const cv = clevis ? '1' : '0';
    if(config==='sq-solid')  return `KLM-${ggModelBase}-0121200000${cv}`;
    if(config==='sq-lights') return `KLM-${ggModelBase}-0222200000${cv}`;
    return null;
  };

  const hasFront = (bp) => bp==='front'||bp==='front-rear';
  const hasRear  = (bp) => bp==='rear' ||bp==='front-rear';

  const steps = [
    // ── Bumper Position ─────────────────────────────────────────────
    {key:'bumper-position', label:'Bumper Position', badge:'req',
     condition:()=>true,
     choices:()=>[
       {val:'front',      label:'Front Bumper Only'},
       {val:'rear',       label:'Rear Bumper Only'},
       {val:'front-rear', label:'Front + Rear Bumpers'},
     ],
    },

    // ══════════════════════════════════════════════════════════
    // FRONT BUMPER
    // ══════════════════════════════════════════════════════════
    {key:'front-series', label:'Front Bumper Series', badge:'req',
     condition:(sel)=>hasFront(sel['bumper-position']),
     choices:()=>[
       {val:'alpha-winch', label:'Alpha Series — Winch Center',  sub:'Winch-ready center — can add Commander Grille Guard'},
       {val:'alpha-light', label:'Alpha Series — Light Center',  sub:'20" light bar cutout — can add Commander Grille Guard'},
       {val:'bravo',       label:'Bravo Series — Light Center',  sub:'Center section with 20" light bar cutout'},
       {val:'delta',       label:'Delta Series — Light Center',  sub:'Center section with 20" light bar cutout'},
     ],
    },
    {key:'front-center-winch', label:'Center Section — Winch', badge:'opt',
     condition:(sel)=>sel['front-series']==='alpha-winch',
     choices:()=>[
       {val:'none',     label:'No Winch — Winch Cutout Included'},
       {val:'war97740', label:'Warn 16.5ti — Hawse Fairlead, Synthetic Rope (+$3,350)', sub:'WAR97740', parts:[{pn:'WAR97740',qty:1}]},
       {val:'war68801', label:'Warn 16.5ti — Roller Fairlead, Steel Cable (+$3,015)',   sub:'WAR68801', parts:[{pn:'WAR68801',qty:1}]},
     ],
    },
    {key:'front-center-light', label:'Center Section — Light Bar', badge:'opt',
     condition:(sel)=>['alpha-light','bravo','delta'].includes(sel['front-series']),
     choices:()=>[
       {val:'none',       label:'No Light Bar — Cutout Included'},
       {val:'e-series',   label:'20" Rigid E-Series Spot/Flood Combo (+$860)',   sub:'RIG120313',    parts:[{pn:'RIG120313',   qty:1}]},
       {val:'e-midnight', label:'20" Rigid E-Series Midnight Edition (+$860)',    sub:'RIG120213BLK', parts:[{pn:'RIG120213BLK',qty:1}]},
     ],
    },
    {key:'front-acc', label:'Adaptive Cruise Control (ACC)', badge:'req',
     condition:(sel)=>{
       const s=sel['front-series'];
       if(!s) return false;
       if(s==='alpha-winch') return !!sel['front-center-winch'];
       return !!sel['front-center-light'];
     },
     choices:()=>[
       {val:'no-acc',   label:'No Adaptive Cruise Control',               sub:'2017-2022 — No ACC sensor module in front bumper'},
       {val:'acc-1719', label:'With Adaptive Cruise Control (2017-2019)', sub:'2017-2019 ACC sensor module'},
       {val:'acc-2022', label:'With Adaptive Cruise Control (2020-2022)', sub:'2020-2022 ACC sensor module — separate P/N family'},
     ],
    },
    {key:'front-endcap', label:'End Cap Width', badge:'req',
     condition:(sel)=>!!sel['front-acc'],
     choices:()=>ecChoices,
    },
    {key:'front-face', label:'Face Style', badge:'req',
     condition:(sel)=>sel['front-series']==='bravo'&&!!sel['front-endcap'],
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Ears'},
     ],
    },
    {key:'front-finish', label:'Bumper Finish', badge:'req',
     condition:(sel)=>sel['front-series']==='bravo' ? !!sel['front-face'] : !!sel['front-endcap'],
     choices:()=>finishChoices,
    },

    // ══════════════════════════════════════════════════════════
    // REAR BUMPER
    // ══════════════════════════════════════════════════════════
    {key:'rear-series', label:'Rear Bumper Series', badge:'req',
     condition:(sel)=>{
       if(!hasRear(sel['bumper-position'])) return false;
       if(sel['bumper-position']==='front-rear') return !!sel['front-finish'];
       return true;
     },
     choices:()=>[
       {val:'alpha', label:'Alpha Series', sub:'Standard rear bumper — stock width'},
       {val:'bravo', label:'Bravo Series', sub:'Stock width — smooth face or clevis ears'},
     ],
    },
    {key:'rear-face', label:'Rear Face Style', badge:'req',
     condition:(sel)=>sel['rear-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Ears'},
     ],
    },
    {key:'rear-parking', label:'Rear Parking Sensors', badge:'req',
     condition:(sel)=>sel['rear-series']==='alpha'||!!sel['rear-face'],
     choices:()=>[
       {val:'with',    label:'With Parking Sensors'},
       {val:'without', label:'No Parking Sensors'},
     ],
    },
    {key:'rear-finish', label:'Rear Bumper Finish', badge:'req',
     mirror:'front-finish',
     condition:(sel)=>!!sel['rear-parking'],
     choices:()=>finishChoices,
    },

    // ══════════════════════════════════════════════════════════
    // GRILLE GUARD (Alpha series only)
    // ══════════════════════════════════════════════════════════
    {key:'gg-config', label:'Commander Grille Guard', badge:'opt',
     condition:(sel)=>{
       if(!['alpha-winch','alpha-light'].includes(sel['front-series'])||!sel['front-finish']) return false;
       if(sel['bumper-position']==='front-rear'&&!sel['rear-finish']) return false;
       return true;
     },
     choices:()=>[
       {val:'none',      label:'No Grille Guard'},
       {val:'sq-solid',  label:'Commander Grille Guard — Square ×2, No Light Cutouts (+$1,100)',             sub:`${ggModelBase}-0121200000X`},
       {val:'sq-lights', label:'Commander Grille Guard — Square ×2 with Light Bar Cutouts (+$1,100)',         sub:`${ggModelBase}-0222200000X`},
     ],
    },
    {key:'gg-clevis', label:'Grille Guard Hook Mounts', badge:'req',
     condition:(sel)=>sel['gg-config']==='sq-solid'||sel['gg-config']==='sq-lights',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the grille guard'},
     ],
    },

    // ══════════════════════════════════════════════════════════
    // ACCESSORIES
    // ══════════════════════════════════════════════════════════
    {key:'front-lp', label:'License Plate Bracket', badge:'opt',
     condition:(sel)=>{
       if(!hasFront(sel['bumper-position'])||!sel['front-finish']) return false;
       if(['alpha-winch','alpha-light'].includes(sel['front-series'])){
         if(!sel['gg-config']) return false;
         if((sel['gg-config']==='sq-solid'||sel['gg-config']==='sq-lights')&&!sel['gg-clevis']) return false;
         return true;
       }
       if(sel['bumper-position']==='front-rear'&&!sel['rear-finish']) return false;
       return true;
     },
     choices:()=>[
       {val:'no',  label:'No License Plate Bracket'},
       {val:'yes', label:'Yes — Add License Plate Bracket', sub:'31910 — Honeycomb Mesh, No Charge', parts:[{pn:'31910',qty:1}]},
     ],
    },

    // ══════════════════════════════════════════════════════════
    // PURCHASED ACCESSORIES
    // ══════════════════════════════════════════════════════════
    {key:'gg-light-bars', label:'Grille Guard — Light Bars', badge:'opt',
     condition:(sel)=>sel['gg-config']==='sq-lights'&&!!sel['front-lp'],
     choices:()=>srLightChoices(2),
    },
    {key:'front-wing-lights', label:'Outer Wing Lights', badge:'opt',
     condition:(sel)=>hasFront(sel['bumper-position'])&&!!sel['front-lp'],
     choices:()=>wingLightChoices(4),
    },
    {key:'front-hooks', label:'Hooks', badge:'opt',
     condition:(sel)=>{
       if(!hasFront(sel['bumper-position'])||!sel['front-lp']) return false;
       const gg=sel['gg-config'], hasGG=gg&&gg!=='none';
       if(hasGG) return sel['gg-clevis']==='clevis';
       if(sel['front-series']==='bravo') return sel['front-face']==='clevis';
       return true;
     },
     choices:()=>hookChoices,
    },
    {key:'rear-lights', label:'Rear Bumper Lights', badge:'opt',
     mirror:'front-wing-lights',
     condition:(sel)=>!!sel['rear-finish'],
     choices:()=>wingLightChoices(2),
    },
    {key:'rear-hooks', label:'Rear Bumper Hooks', badge:'opt',
     mirror:'front-hooks',
     condition:(sel)=>!!sel['rear-finish']&&(sel['rear-series']==='alpha'||sel['rear-face']==='clevis'),
     choices:()=>hookChoices,
    },
  ];

  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Front & rear bumpers with accessories'}],
    steps,
    buildParts:(kit,sel)=>{
      const parts=[];
      const hookPN  = {sw1b:'MH-SW1B',sw1c:'MH-SW1C',sw1s:'MH-SW1S',sw1a:'MH-SW1A',sw1r:'MH-SW1R',rs78xlb:'MH-RS78XLB'};
      const wingPN  = {flood:'RIG104113',spot:'RIG104213','midnight-spot':'RIG104213BLK'};
      const bp      = sel['bumper-position']||'';
      const acc     = sel['front-acc']||'no-acc';
      const wide    = sel['front-endcap']||'0000';
      const fs      = sel['front-series']||'';
      const fClevis = sel['front-face']==='clevis';
      const gg      = hasFront(bp) ? (sel['gg-config']||'none') : 'none';
      const ggClevis= sel['gg-clevis']==='clevis';

      // ── GROUP 1: STRUCTURAL PARTS ──────────────────────────────
      // Front bumper
      if(hasFront(bp)){
        const pn = frontPN(acc, fs, wide, fClevis);
        if(pn) parts.push({section:'Front Bumper', pn, qty:1});
      }

      // Rear bumper
      if(hasRear(bp)){
        const rs      = sel['rear-series']||'alpha';
        const rClevis = sel['rear-face']==='clevis';
        const sensors = sel['rear-parking']==='with' ? 'with' : 'without';
        const rpn     = rearPN(sensors, rs, rClevis);
        if(rpn) parts.push({section:'Rear Bumper', pn:rpn, qty:1});
      }

      // Grille guard
      if(hasFront(bp)){
        const ggpn = ggPN17(gg, ggClevis);
        if(ggpn) parts.push({section:'Grille Guard', pn:ggpn, qty:1});
      }

      // License plate bracket
      if(hasFront(bp)&&sel['front-lp']==='yes')
        parts.push({section:'Accessories', pn:'31910', qty:1});

      // ── GROUP 2: PURCHASED ACCESSORIES ────────────────────────
      // Winch
      if(hasFront(bp)){
        if(sel['front-center-winch']==='war97740') parts.push({section:'Winch', pn:'WAR97740', qty:1});
        if(sel['front-center-winch']==='war68801') parts.push({section:'Winch', pn:'WAR68801', qty:1});

        // Center light bar
        const clMap={'e-series':'RIG120313','e-midnight':'RIG120213BLK'};
        if(clMap[sel['front-center-light']]) parts.push({section:'Bumper Lights', pn:clMap[sel['front-center-light']], qty:1});

        // Outer wing lights (qty 4)
        if(wingPN[sel['front-wing-lights']]) parts.push({section:'Bumper Lights', pn:wingPN[sel['front-wing-lights']], qty:4});

        // Grille guard lights
        if(gg==='sq-lights'&&sel['gg-light-bars']&&sel['gg-light-bars']!=='none'){
          const lgMap={'sr-midnight':'RIG920214BLK','sr-combo':'RIG920314','sr-driving':'RIG921314'};
          if(lgMap[sel['gg-light-bars']]) parts.push({section:'Grille Guard Lights', pn:lgMap[sel['gg-light-bars']], qty:2});
        }

        // Front hooks + locking pins
        const fh=sel['front-hooks'];
        if(fh&&fh!=='none'&&hookPN[fh]){
          parts.push({section:'Hooks', pn:hookPN[fh], qty:2});
          if(gg&&gg!=='none') parts.push({section:'Hooks', pn:'61000', qty:2});
        }
      }

      // Rear lights and hooks
      if(hasRear(bp)){
        if(wingPN[sel['rear-lights']]) parts.push({section:'Bumper Lights', pn:wingPN[sel['rear-lights']], qty:2});
        const rh=sel['rear-hooks'];
        if(rh&&rh!=='none'&&hookPN[rh]) parts.push({section:'Hooks', pn:hookPN[rh], qty:2});
      }

      return parts;
    },
  };
}

// ─── RAM Super Duty bumper platform generator ─────────────────────────────────
// frontModelBase  : e.g. '401041025' (2025+ RAM 2500 front)
// ggModelBase     : e.g. '201041019' (RAM 2500 GG — shared 2019+/2025+)
// rearModelBase   : e.g. '401041019' (2019+ rear), null for CC (no rear data)
// hasStockWidth   : true for 2500/3500 pickup, false for 4500/5500 CC
// isRam3500       : true adds SRW/DRW step for rear bumper
function ramSDBumper(id, yr_from, yr_to, make, model, label, frontModelBase, ggModelBase, rearModelBase, hasStockWidth, isRam3500) {
  const hookChoices = [
    {val:'none',    label:'No Hooks'},
    {val:'sw1b',    label:'Monster Hooks Swivel Hook — Satin Black (+$500)',         sub:'MH-SW1B × 2'},
    {val:'sw1c',    label:'Monster Hooks Swivel Hook — Chrome Plated (+$600)',        sub:'MH-SW1C × 2'},
    {val:'sw1s',    label:'Monster Hooks Swivel Hook — Silver Powder Coat (+$500)',   sub:'MH-SW1S × 2'},
    {val:'sw1a',    label:'Monster Hooks Swivel Hook — Raw Aluminum (+$500)',         sub:'MH-SW1A × 2'},
    {val:'sw1r',    label:'Monster Hooks Swivel Hook — Candy Red (+$500)',            sub:'MH-SW1R × 2'},
    {val:'rs78xlb', label:'Monster Hooks Reaper Hook (+$350)',                        sub:'MH-RS78XLB × 2'},
  ];
  const wingLightChoices = (qty)=>[
    {val:'none',          label:`No Lights — Cutout${qty>1?'s':''} Included`},
    {val:'flood',         label:`(${qty}) 4" Rigid E-Series Flood (+$${qty*310})`,         sub:`RIG104113 × ${qty}`},
    {val:'spot',          label:`(${qty}) 4" Rigid E-Series Spot (+$${qty*310})`,          sub:`RIG104213 × ${qty}`},
    {val:'midnight-spot', label:`(${qty}) 4" Rigid E-Series Midnight Spot (+$${qty*310})`, sub:`RIG104213BLK × ${qty}`},
  ];
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];
  const srLightChoices = (qty)=>[
    {val:'none',       label:'No Light Bars — Cutouts Included'},
    {val:'sr-midnight',label:`20" SR-Series Midnight Edition PRO — Hybrid/Spot (+$${qty*670})`,  sub:`RIG920214BLK × ${qty}`},
    {val:'sr-combo',   label:`20" SR-Series PRO — Spot/Flood Combo (+$${qty*670})`,              sub:`RIG920314 × ${qty}`},
    {val:'sr-driving', label:`20" SR-Series PRO — Spot/Driving Combo (+$${qty*780})`,            sub:`RIG921314 × ${qty}`},
  ];

  // GG P/N: sq-solid = 2 sq tubes no cutouts, sq-lights = 2 sq tubes with 20" cutouts
  const ggPN = (config, clevis) => {
    const cv = clevis ? '1' : '0';
    if(config==='sq-solid')  return `KLM-${ggModelBase}-0111100000${cv}`;
    if(config==='sq-lights') return `KLM-${ggModelBase}-0212100000${cv}`;
    if(config==='headlight') return null; // handled separately in buildParts based on gg-hl-config
    return null;
  };

  const hasFrontPos = (sel)=>['front','front-rear-pu'].includes(sel['bumper-position']);
  const hasRearPos  = (sel)=>!!rearModelBase&&['rear-pu','front-rear-pu'].includes(sel['bumper-position']);

  const steps = [
    // ── Bumper Position ──────────────────────────────────────────
    {key:'bumper-position', label:'Bumper Position', badge:'req',
     condition:()=>true,
     choices:()=>{
       const opts=[{val:'front',label:'Front Bumper Only'}];
       if(rearModelBase){
         opts.push({val:'rear-pu',      label:'Rear Bumper Only'});
         opts.push({val:'front-rear-pu',label:'Front + Rear Bumper'});
       }
       return opts;
     },
    },

    // ══ FRONT BUMPER PATH ═════════════════════════════════════════
    {key:'front-series', label:'Front Bumper Series', badge:'req',
     condition:(sel)=>hasFrontPos(sel),
     choices:()=>[
       {val:'alpha', label:'Alpha Series', sub:'Winch-ready or light center — can add Commander Grille Guard'},
       {val:'bravo', label:'Bravo Series', sub:'Clean face design — smooth or clevis hook mounts'},
       {val:'delta', label:'Delta Series', sub:'Center section with 20" light bar cutout'},
     ],
    },
    // Alpha: center type determines bumper P/N (Light Center vs Winch Center)
    {key:'alpha-center-type', label:'Alpha Center Section', badge:'req',
     condition:(sel)=>sel['front-series']==='alpha',
     choices:()=>[
       {val:'light', label:'Light Center', sub:'20" center section for E-Series light bar'},
       {val:'winch', label:'Winch Center', sub:'Winch-ready center mount'},
     ],
    },
    // Bravo: smooth face or clevis hook mounts
    {key:'bravo-face', label:'Face Style', badge:'req',
     condition:(sel)=>sel['front-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the bumper'},
     ],
    },
    // GG — Alpha only; sq-solid, sq-lights, or headlight (TBD)
    {key:'gg-config', label:'Commander Grille Guard', badge:'opt',
     condition:(sel)=>sel['front-series']==='alpha'&&!!sel['alpha-center-type'],
     choices:()=>[
       {val:'none',      label:'No Grille Guard'},
       {val:'sq-solid',  label:'Commander Grille Guard — Square × 2 Crossbars, No Light Cutouts (+$1,100)', sub:`KLM-${ggModelBase}-01111000...`},
       {val:'sq-lights', label:'Commander Grille Guard — Square × 2 Crossbars with Light Bar Cutouts (+$1,100)', sub:`KLM-${ggModelBase}-02121000...`},
       {val:'headlight', label:'Commander Grille Guard + Headlight Guards (+$1,400)', sub:'KLM-201041019-1XX03050001 — Always w/ Clevis Ears — 2019+ RAM 2500/3500/4500/5500'},
     ],
    },
    // GG clevis hook mounts (sq-solid / sq-lights only)
    {key:'gg-clevis', label:'Grille Guard Hook Mounts', badge:'req',
     condition:(sel)=>sel['gg-config']==='sq-solid'||sel['gg-config']==='sq-lights',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the grille guard'},
     ],
    },
    // Headlight Guard center section (only when gg-config === 'headlight')
    {key:'gg-hl-config', label:'Headlight Guard — Center Section', badge:'req',
     condition:(sel)=>sel['gg-config']==='headlight',
     choices:()=>[
       {val:'none',        label:'No Center Light Bar',                                         sub:'KLM-201041019-11103050001', parts:[{pn:'KLM-201041019-11103050001',qty:1}]},
       {val:'20-sr',       label:'20" SR Series Light (+$670)',  sub:'RIG920314 — KLM-201041019-12103050001', parts:[{pn:'KLM-201041019-12103050001',qty:1}]},
       {val:'360-connect', label:'30" Rigid 360-Connect (+$2,100)', sub:'RIG36306 — KLM-201041019-11903050001', parts:[{pn:'KLM-201041019-11903050001',qty:1}]},
       {val:'sr-camera',   label:'SR Light + Camera Mount',         sub:'KLM-201041019-11703050001', parts:[{pn:'KLM-201041019-11703050001',qty:1}]},
     ],
    },
    // End cap — pickup only (CC auto-selects 2.375")
    {key:'front-endcap', label:'End Cap Width', badge:'req',
     condition:(sel)=>hasFrontPos(sel)&&!!sel['front-series']&&hasStockWidth,
     choices:()=>[
       {val:'stock',    label:'Stock Width'},
       {val:'wide-100', label:'1.0" Wide End Caps'},
     ],
    },
    // Finish
    {key:'front-finish', label:'Bumper Finish', badge:'req',
     condition:(sel)=>{
       if(!hasFrontPos(sel)||!sel['front-series']) return false;
       if(sel['front-series']==='alpha'&&!sel['alpha-center-type']) return false;
       if(sel['front-series']==='bravo'&&!sel['bravo-face']) return false;
       if(hasStockWidth&&!sel['front-endcap']) return false;
       return true;
     },
     choices:()=>finishChoices,
    },
    // License plate bracket — right after finish
    {key:'front-lp', label:'License Plate Bracket', badge:'opt',
     condition:(sel)=>!!sel['front-finish'],
     choices:()=>[
       {val:'no',  label:'No License Plate Bracket'},
       {val:'yes', label:'Yes — Add License Plate Bracket', sub:'31910 — Honeycomb Mesh, No Charge'},
     ],
    },
    // Center light bar — Alpha Light, Bravo, or Delta all have a 20" center cutout
    {key:'alpha-light-bar', label:'Center Light Bar', badge:'opt',
     condition:(sel)=>{
       if(sel['front-series']==='delta'||sel['front-series']==='bravo') return !!sel['front-finish'];
       return sel['front-series']==='alpha'&&sel['alpha-center-type']==='light'&&!!sel['gg-config']&&sel['gg-config']!=='headlight';
     },
     choices:()=>[
       {val:'none',       label:'No Center Light Bar — Cutout Included'},
       {val:'e-series',   label:'20" Rigid E-Series Spot/Flood Combo (+$860)',       sub:'RIG120313'},
       {val:'e-midnight', label:'20" Rigid E-Series Midnight Edition Spot (+$860)',  sub:'RIG120213BLK'},
     ],
    },
    // Alpha Winch accessory
    {key:'alpha-winch-acc', label:'Winch', badge:'opt',
     condition:(sel)=>sel['front-series']==='alpha'&&sel['alpha-center-type']==='winch',
     choices:()=>[
       {val:'none',     label:'No Winch — Winch Center Included'},
       {val:'war97740', label:'Warn 16.5ti — Hawse Fairlead, Synthetic Rope (+$3,350)', sub:'WAR97740'},
       {val:'war68801', label:'Warn 16.5ti — Roller Fairlead, Steel Cable (+$3,015)',   sub:'WAR68801'},
     ],
    },
    // GG light bars (sq-lights — 2 cutouts)
    {key:'gg-light-bars', label:'Grille Guard — Light Bar Selection', badge:'opt',
     condition:(sel)=>sel['gg-config']==='sq-lights',
     choices:()=>srLightChoices(2),
    },
    // Outer wing lights (all front bumpers — qty 4)
    {key:'front-wing-lights', label:'Outer Wing Lights', badge:'opt',
     condition:(sel)=>!!sel['front-finish'],
     choices:()=>wingLightChoices(4),
    },
    // Hooks: Delta always; Bravo when clevis; Alpha when no-GG, headlight-GG, or GG-clevis
    {key:'front-hooks', label:'Hooks', badge:'opt',
     condition:(sel)=>!!sel['front-finish']&&(
       sel['front-series']==='delta'||
       (sel['front-series']==='bravo'&&sel['bravo-face']==='clevis')||
       (sel['front-series']==='alpha'&&(!sel['gg-config']||sel['gg-config']==='none'||sel['gg-config']==='headlight'||sel['gg-clevis']==='clevis'))
     ),
     choices:()=>hookChoices,
    },

    // ══ REAR BUMPER — PICKUP PATH ═════════════════════════════════
    {key:'rear-pu-series', label:'Rear Bumper Series', badge:'req',
     condition:(sel)=>hasRearPos(sel),
     choices:()=>[
       {val:'alpha', label:'Alpha Series'},
       {val:'bravo', label:'Bravo Series', sub:'Available with smooth face or clevis hook mounts'},
     ],
    },
    {key:'rear-pu-face', label:'Rear Face Style', badge:'req',
     condition:(sel)=>hasRearPos(sel)&&sel['rear-pu-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts'},
     ],
    },
    // SRW / DRW — RAM 3500 only
    {key:'rear-wheel-type', label:'Rear Wheel Configuration', badge:'req',
     condition:(sel)=>!!isRam3500&&hasRearPos(sel)&&!!sel['rear-pu-series']&&(sel['rear-pu-series']!=='bravo'||!!sel['rear-pu-face']),
     choices:()=>[
       {val:'srw', label:'Single Rear Wheel (SRW)'},
       {val:'drw', label:'Dual Rear Wheel (DRW)'},
     ],
    },
    {key:'rear-pu-finish', label:'Rear Bumper Finish', badge:'req',
     mirror:'front-finish',
     condition:(sel)=>hasRearPos(sel)&&!!sel['rear-pu-series']&&(sel['rear-pu-series']!=='bravo'||!!sel['rear-pu-face'])&&(!isRam3500||!!sel['rear-wheel-type']),
     choices:()=>finishChoices,
    },
    {key:'rear-pu-lights', label:'Rear Bumper Lights', badge:'opt',
     mirror:'front-wing-lights',
     condition:(sel)=>!!sel['rear-pu-finish'],
     choices:()=>wingLightChoices(2),
    },
    {key:'rear-pu-hooks', label:'Rear Bumper Hooks', badge:'opt',
     mirror:'front-hooks',
     condition:(sel)=>!!sel['rear-pu-finish']&&(sel['rear-pu-series']==='alpha'||sel['rear-pu-face']==='clevis'),
     choices:()=>hookChoices,
    },
  ];

  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Front & rear bumpers with accessories'}],
    steps,
    buildParts:(kit,sel)=>{
      const parts=[];
      const hookPN={sw1b:'MH-SW1B',sw1c:'MH-SW1C',sw1s:'MH-SW1S',sw1a:'MH-SW1A',sw1r:'MH-SW1R',rs78xlb:'MH-RS78XLB'};
      const wingPN={flood:'RIG104113',spot:'RIG104213','midnight-spot':'RIG104213BLK'};
      const bp=sel['bumper-position']||'';

      // ── FRONT ──────────────────────────────────────────────────
      if(hasFrontPos(sel)){
        const series=sel['front-series'];
        const ct=sel['alpha-center-type']||'light';
        const scMap={'alpha-light':'01','alpha-winch':'02','bravo':'03','delta':'04'};
        const sc=scMap[series==='alpha'?`alpha-${ct}`:series];
        if(sc){
          let pn;
          if(hasStockWidth){
            // Pickup: 001 + sc(2) + ec(1) + clevis(3) = 9 chars
            const ec=sel['front-endcap']==='wide-100'?'1':'0';
            const cv=(series==='bravo'&&sel['bravo-face']==='clevis')?'001':'000';
            pn=`KLM-${frontModelBase}-001${sc}${ec}${cv}`;
          } else {
            // CC: 001 + sc(2) + 230 + clevis(1) = 9 chars
            const cv=(series==='bravo'&&sel['bravo-face']==='clevis')?'1':'0';
            pn=`KLM-${frontModelBase}-001${sc}230${cv}`;
          }
          parts.push({section:'Front Bumper',pn,qty:1});
        }

        // Grille guard
        const gg=sel['gg-config'];
        const clevis=gg==='headlight'||sel['gg-clevis']==='clevis';
        if(gg==='headlight'){
          const hlMap={'none':'KLM-201041019-11103050001','20-sr':'KLM-201041019-12103050001','360-connect':'KLM-201041019-11903050001','sr-camera':'KLM-201041019-11703050001'};
          const hlpn=hlMap[sel['gg-hl-config']];
          if(hlpn) parts.push({section:'Grille Guard',pn:hlpn,qty:1});
        } else {
          const ggpn=ggPN(gg,clevis);
          if(ggpn) parts.push({section:'Grille Guard',pn:ggpn,qty:1});
        }

        // GG light bars (sq-lights → 2 × SR-Series)
        if(gg==='sq-lights'){
          const srMap={'sr-midnight':'RIG920214BLK','sr-combo':'RIG920314','sr-driving':'RIG921314'};
          if(srMap[sel['gg-light-bars']]) parts.push({section:'Grille Guard Lights',pn:srMap[sel['gg-light-bars']],qty:2});
        }

        // Winch
        if(sel['alpha-winch-acc']==='war97740') parts.push({section:'Winch',pn:'WAR97740',qty:1});
        if(sel['alpha-winch-acc']==='war68801') parts.push({section:'Winch',pn:'WAR68801',qty:1});

        // Alpha light center bar
        const dcMap={'e-series':'RIG120313','e-midnight':'RIG120213BLK'};
        if(dcMap[sel['alpha-light-bar']]) parts.push({section:'Bumper Lights',pn:dcMap[sel['alpha-light-bar']],qty:1});

        // Outer wing lights (qty 4)
        if(wingPN[sel['front-wing-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['front-wing-lights']],qty:4});

        // License plate
        if(sel['front-lp']==='yes') parts.push({section:'Accessories',pn:'31910',qty:1});

        // Hooks + locking pins: GG with clevis OR Bravo bumper with clevis face
        const fh=sel['front-hooks'];
        if(fh&&fh!=='none'&&hookPN[fh]){
          parts.push({section:'Hooks',pn:hookPN[fh],qty:2});
          const needsFrontLP=(gg&&gg!=='none'&&sel['gg-clevis']==='clevis')||(sel['front-series']==='bravo'&&sel['bravo-face']==='clevis');
          if(needsFrontLP) parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }

      // ── REAR PICKUP ────────────────────────────────────────────
      if(rearModelBase&&['rear-pu','front-rear-pu'].includes(bp)){
        const rs=sel['rear-pu-series'];
        const rf=sel['rear-pu-face'];
        const isDrw=isRam3500&&sel['rear-wheel-type']==='drw';
        const sensorCode=isDrw?'106':'104';
        const rsc=rs==='bravo'?'03':'00';
        const rcv=(rs==='bravo'&&rf==='clevis')?'0001':'0000';
        parts.push({section:'Rear Bumper',pn:`KLM-${rearModelBase}-${sensorCode}${rsc}${rcv}`,qty:1});
        if(wingPN[sel['rear-pu-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['rear-pu-lights']],qty:2});
        const rph=sel['rear-pu-hooks'];
        if(rph&&rph!=='none'&&hookPN[rph]){
          parts.push({section:'Hooks',pn:hookPN[rph],qty:2});
          if(rs==='bravo'&&rf==='clevis') parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }

      return parts;
    },
  };
}

// ═══════════════════════════════════════════════════════════════
// Helper — RAM 2500/3500 Pickup + 4500/5500 CC Bumper Platform (2010-2018)
// P/N differences from 2019+: '-02' suffix, 1.75" wide code '1700', '101' rear sensor prefix
// frontModelBase : e.g. '401041010' (2010-2018 RAM 2500 front)
// ggModelBase    : e.g. '201041010' (RAM 2500 GG — 2010-2018), null for CC
// rearModelBase  : e.g. '401041010' (2010-2018 rear), null for CC
// hasStockWidth  : true for 2500/3500 pickup, false for 4500/5500 CC
// ═══════════════════════════════════════════════════════════════
function ramSDBumper2010(id, yr_from, yr_to, make, model, label, frontModelBase, ggModelBase, rearModelBase, hasStockWidth) {
  const hookChoices = [
    {val:'none',    label:'No Hooks'},
    {val:'sw1b',    label:'Monster Hooks Swivel Hook — Satin Black (+$500)',         sub:'MH-SW1B × 2'},
    {val:'sw1c',    label:'Monster Hooks Swivel Hook — Chrome Plated (+$600)',        sub:'MH-SW1C × 2'},
    {val:'sw1s',    label:'Monster Hooks Swivel Hook — Silver Powder Coat (+$500)',   sub:'MH-SW1S × 2'},
    {val:'sw1a',    label:'Monster Hooks Swivel Hook — Raw Aluminum (+$500)',         sub:'MH-SW1A × 2'},
    {val:'sw1r',    label:'Monster Hooks Swivel Hook — Candy Red (+$500)',            sub:'MH-SW1R × 2'},
    {val:'rs78xlb', label:'Monster Hooks Reaper Hook (+$350)',                        sub:'MH-RS78XLB × 2'},
  ];
  const wingLightChoices = (qty)=>[
    {val:'none',          label:`No Lights — Cutout${qty>1?'s':''} Included`},
    {val:'flood',         label:`(${qty}) 4" Rigid E-Series Flood (+$${qty*310})`,         sub:`RIG104113 × ${qty}`},
    {val:'spot',          label:`(${qty}) 4" Rigid E-Series Spot (+$${qty*310})`,          sub:`RIG104213 × ${qty}`},
    {val:'midnight-spot', label:`(${qty}) 4" Rigid E-Series Midnight Spot (+$${qty*310})`, sub:`RIG104213BLK × ${qty}`},
  ];
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];
  const srLightChoices = (qty)=>[
    {val:'none',       label:'No Light Bars — Cutouts Included'},
    {val:'sr-midnight',label:`20" SR-Series Midnight Edition PRO — Hybrid/Spot (+$${qty*670})`,  sub:`RIG920214BLK × ${qty}`},
    {val:'sr-combo',   label:`20" SR-Series PRO — Spot/Flood Combo (+$${qty*670})`,              sub:`RIG920314 × ${qty}`},
    {val:'sr-driving', label:`20" SR-Series PRO — Spot/Driving Combo (+$${qty*780})`,            sub:`RIG921314 × ${qty}`},
  ];

  // 2010-2018 GG: sq-solid=Sq.×2 no cutouts, sq-lights=Sq.×2 w/light bar cutouts
  const ggPN = (config, clevis) => {
    const cv = clevis ? '1' : '0';
    if(config==='sq-solid')  return `KLM-${ggModelBase}-0121200000${cv}`;
    if(config==='sq-lights') return `KLM-${ggModelBase}-0222200000${cv}`;
    return null;
  };

  const hasFrontPos = (sel)=>['front','front-rear-pu'].includes(sel['bumper-position']);
  const hasRearPos  = (sel)=>!!rearModelBase&&['rear-pu','front-rear-pu'].includes(sel['bumper-position']);

  const steps = [
    // ── Bumper Position ──────────────────────────────────────────
    {key:'bumper-position', label:'Bumper Position', badge:'req',
     condition:()=>true,
     choices:()=>{
       const opts=[{val:'front',label:'Front Bumper Only'}];
       if(rearModelBase){
         opts.push({val:'rear-pu',      label:'Rear Bumper Only'});
         opts.push({val:'front-rear-pu',label:'Front + Rear Bumper'});
       }
       return opts;
     },
    },
    // ── Parking Sensors (pickup only) ────────────────────────────
    {key:'parking-sensors', label:'Parking Sensors', badge:'req',
     condition:(sel)=>hasStockWidth&&!!sel['bumper-position'],
     choices:()=>[
       {val:'yes', label:'With Factory Parking Sensors', sub:'Vehicle has factory parking sensors — select this to ensure correct bumper variant'},
       {val:'no',  label:'No Parking Sensors'},
     ],
    },
    // ══ FRONT BUMPER PATH ═════════════════════════════════════════
    {key:'front-series', label:'Front Bumper Series', badge:'req',
     condition:(sel)=>hasFrontPos(sel)&&(!hasStockWidth||!!sel['parking-sensors']),
     choices:()=>[
       {val:'alpha', label:'Alpha Series', sub:'Winch-ready or light center — can add Commander Grille Guard'},
       {val:'bravo', label:'Bravo Series', sub:'Clean face design — smooth or clevis hook mounts'},
     ],
    },
    {key:'alpha-center-type', label:'Alpha Center Section', badge:'req',
     condition:(sel)=>sel['front-series']==='alpha',
     choices:()=>[
       {val:'light', label:'Light Center', sub:'20" center section for E-Series light bar'},
       {val:'winch', label:'Winch Center', sub:'Winch-ready center mount'},
     ],
    },
    {key:'bravo-face', label:'Face Style', badge:'req',
     condition:(sel)=>sel['front-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the bumper'},
     ],
    },
    // GG — Alpha only
    {key:'gg-config', label:'Commander Grille Guard', badge:'opt',
     condition:(sel)=>!!ggModelBase&&sel['front-series']==='alpha'&&!!sel['alpha-center-type'],
     choices:()=>[
       {val:'none',      label:'No Grille Guard'},
       {val:'sq-solid',  label:'Commander Grille Guard — Square × 2 Crossbars, No Light Cutouts (+$1,100)', sub:`KLM-${ggModelBase}-01212000...`},
       {val:'sq-lights', label:'Commander Grille Guard — Square × 2 Crossbars with Light Bar Cutouts (+$1,100)', sub:`KLM-${ggModelBase}-02222000...`},
     ],
    },
    {key:'gg-clevis', label:'Grille Guard Hook Mounts', badge:'req',
     condition:(sel)=>sel['gg-config']==='sq-solid'||sel['gg-config']==='sq-lights',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the grille guard'},
     ],
    },
    // End cap — pickup only (1.75" wide for 2010-2018); CC auto-selects 3.5"
    {key:'front-endcap', label:'End Cap Width', badge:'req',
     condition:(sel)=>hasFrontPos(sel)&&!!sel['front-series']&&hasStockWidth,
     choices:()=>[
       {val:'stock',    label:'Stock Width'},
       {val:'wide-175', label:'1.75" Wide End Caps'},
     ],
    },
    {key:'front-finish', label:'Bumper Finish', badge:'req',
     condition:(sel)=>{
       if(!hasFrontPos(sel)||!sel['front-series']) return false;
       if(sel['front-series']==='alpha'&&!sel['alpha-center-type']) return false;
       if(sel['front-series']==='bravo'&&!sel['bravo-face']) return false;
       if(hasStockWidth&&!sel['front-endcap']) return false;
       return true;
     },
     choices:()=>finishChoices,
    },
    {key:'front-lp', label:'License Plate Bracket', badge:'opt',
     condition:(sel)=>!!sel['front-finish'],
     choices:()=>[
       {val:'no',  label:'No License Plate Bracket'},
       {val:'yes', label:'Yes — Add License Plate Bracket', sub:'31910 — Honeycomb Mesh, No Charge'},
     ],
    },
    {key:'alpha-light-bar', label:'Center Light Bar', badge:'opt',
     condition:(sel)=>{
       if(sel['front-series']==='bravo') return !!sel['front-finish'];
       return sel['front-series']==='alpha'&&sel['alpha-center-type']==='light'&&!!sel['gg-config']&&sel['gg-config']!=='headlight';
     },
     choices:()=>[
       {val:'none',       label:'No Center Light Bar — Cutout Included'},
       {val:'e-series',   label:'20" Rigid E-Series Spot/Flood Combo (+$860)',       sub:'RIG120313'},
       {val:'e-midnight', label:'20" Rigid E-Series Midnight Edition Spot (+$860)',  sub:'RIG120213BLK'},
     ],
    },
    {key:'alpha-winch-acc', label:'Winch', badge:'opt',
     condition:(sel)=>sel['front-series']==='alpha'&&sel['alpha-center-type']==='winch',
     choices:()=>[
       {val:'none',     label:'No Winch — Winch Center Included'},
       {val:'war97740', label:'Warn 16.5ti — Hawse Fairlead, Synthetic Rope (+$3,350)', sub:'WAR97740'},
       {val:'war68801', label:'Warn 16.5ti — Roller Fairlead, Steel Cable (+$3,015)',   sub:'WAR68801'},
     ],
    },
    {key:'gg-light-bars', label:'Grille Guard — Light Bar Selection', badge:'opt',
     condition:(sel)=>sel['gg-config']==='sq-lights',
     choices:()=>srLightChoices(2),
    },
    {key:'front-wing-lights', label:'Outer Wing Lights', badge:'opt',
     condition:(sel)=>!!sel['front-finish'],
     choices:()=>wingLightChoices(4),
    },
    {key:'front-hooks', label:'Hooks', badge:'opt',
     condition:(sel)=>!!sel['front-finish']&&(
       (sel['front-series']==='bravo'&&sel['bravo-face']==='clevis')||
       (sel['front-series']==='alpha'&&(!sel['gg-config']||sel['gg-config']==='none'||sel['gg-clevis']==='clevis'))
     ),
     choices:()=>hookChoices,
    },
    // ══ REAR BUMPER — PICKUP PATH ═════════════════════════════════
    {key:'rear-pu-series', label:'Rear Bumper Series', badge:'req',
     condition:(sel)=>hasRearPos(sel)&&(!hasStockWidth||!!sel['parking-sensors']),
     choices:()=>[
       {val:'alpha', label:'Alpha Series'},
       {val:'bravo', label:'Bravo Series', sub:'Available with smooth face or clevis hook mounts'},
     ],
    },
    {key:'rear-pu-face', label:'Rear Face Style', badge:'req',
     condition:(sel)=>hasRearPos(sel)&&sel['rear-pu-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts'},
     ],
    },
    {key:'rear-pu-finish', label:'Rear Bumper Finish', badge:'req',
     mirror:'front-finish',
     condition:(sel)=>hasRearPos(sel)&&!!sel['rear-pu-series']&&(sel['rear-pu-series']!=='bravo'||!!sel['rear-pu-face']),
     choices:()=>finishChoices,
    },
    {key:'rear-pu-lights', label:'Rear Bumper Lights', badge:'opt',
     mirror:'front-wing-lights',
     condition:(sel)=>!!sel['rear-pu-finish'],
     choices:()=>wingLightChoices(2),
    },
    {key:'rear-pu-hooks', label:'Rear Bumper Hooks', badge:'opt',
     mirror:'front-hooks',
     condition:(sel)=>!!sel['rear-pu-finish']&&(sel['rear-pu-series']==='alpha'||sel['rear-pu-face']==='clevis'),
     choices:()=>hookChoices,
    },
  ];

  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Front & rear bumpers with accessories'}],
    steps,
    buildParts:(kit,sel)=>{
      const parts=[];
      const hookPN={sw1b:'MH-SW1B',sw1c:'MH-SW1C',sw1s:'MH-SW1S',sw1a:'MH-SW1A',sw1r:'MH-SW1R',rs78xlb:'MH-RS78XLB'};
      const wingPN={flood:'RIG104113',spot:'RIG104213','midnight-spot':'RIG104213BLK'};
      const bp=sel['bumper-position']||'';

      // ── FRONT ──────────────────────────────────────────────────
      if(hasFrontPos(sel)){
        const series=sel['front-series'];
        const ct=sel['alpha-center-type']||'light';
        const scMap={'alpha-light':'01','alpha-winch':'02','bravo':'03'};
        const sc=scMap[series==='alpha'?`alpha-${ct}`:series];
        if(sc){
          let pn;
          if(hasStockWidth){
            // Pickup: 001/002 (PS) + sc(2) + width3(3) + clevis(1) + '-02' suffix
            const ps=sel['parking-sensors']==='yes'?'001':'002';
            const wd=sel['front-endcap']==='wide-175'?'170':'000';
            const clv=(series==='bravo'&&sel['bravo-face']==='clevis')?'1':'0';
            pn=`KLM-${frontModelBase}-${ps}${sc}${wd}${clv}-02`;
          } else {
            // CC: 002 + sc(2) + 3500 + clevis(1) + '-02' suffix (no PS, fixed 3.5" width)
            const clv=(series==='bravo'&&sel['bravo-face']==='clevis')?'1':'0';
            pn=`KLM-${frontModelBase}-002${sc}3500${clv}-02`;
          }
          parts.push({section:'Front Bumper',pn,qty:1});
        }

        // Grille guard
        if(ggModelBase){
          const gg=sel['gg-config'];
          const clevis=sel['gg-clevis']==='clevis';
          const ggpn=ggPN(gg,clevis);
          if(ggpn) parts.push({section:'Grille Guard',pn:ggpn,qty:1});
          if(gg==='sq-lights'){
            const srMap={'sr-midnight':'RIG920214BLK','sr-combo':'RIG920314','sr-driving':'RIG921314'};
            if(srMap[sel['gg-light-bars']]) parts.push({section:'Grille Guard Lights',pn:srMap[sel['gg-light-bars']],qty:2});
          }
        }

        // Winch
        if(sel['alpha-winch-acc']==='war97740') parts.push({section:'Winch',pn:'WAR97740',qty:1});
        if(sel['alpha-winch-acc']==='war68801') parts.push({section:'Winch',pn:'WAR68801',qty:1});

        // Center light bar
        const dcMap={'e-series':'RIG120313','e-midnight':'RIG120213BLK'};
        if(dcMap[sel['alpha-light-bar']]) parts.push({section:'Bumper Lights',pn:dcMap[sel['alpha-light-bar']],qty:1});

        // Outer wing lights (qty 4)
        if(wingPN[sel['front-wing-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['front-wing-lights']],qty:4});

        // License plate
        if(sel['front-lp']==='yes') parts.push({section:'Accessories',pn:'31910',qty:1});

        // Hooks + locking pins
        const fh=sel['front-hooks'];
        if(fh&&fh!=='none'&&hookPN[fh]){
          parts.push({section:'Hooks',pn:hookPN[fh],qty:2});
          const needsLP=(ggModelBase&&sel['gg-clevis']==='clevis')||(sel['front-series']==='bravo'&&sel['bravo-face']==='clevis');
          if(needsLP) parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }

      // ── REAR PICKUP ────────────────────────────────────────────
      if(rearModelBase&&['rear-pu','front-rear-pu'].includes(bp)){
        const rs=sel['rear-pu-series'];
        const rf=sel['rear-pu-face'];
        const rsc=rs==='bravo'?'03':'00';
        const rcv=(rs==='bravo'&&rf==='clevis')?'0001':'0000';
        const rps=sel['parking-sensors']==='yes'?'101':'102';
        parts.push({section:'Rear Bumper',pn:`KLM-${rearModelBase}-${rps}${rsc}${rcv}-02`,qty:1});
        if(wingPN[sel['rear-pu-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['rear-pu-lights']],qty:2});
        const rph=sel['rear-pu-hooks'];
        if(rph&&rph!=='none'&&hookPN[rph]){
          parts.push({section:'Hooks',pn:hookPN[rph],qty:2});
          if(rs==='bravo'&&rf==='clevis') parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }

      return parts;
    },
  };
}

// ═══════════════════════════════════════════════════════════════
// Helper — GM 2500/3500 HD Pickup Bumper Platform (2020+)
// frontModelBase : e.g. '400002024' (2024+ Chev 2500 front bumper base)
// ggModelBase    : e.g. '200002020' (Chev 2500 GG — covers 2020+)
// rearModelBase  : e.g. '400002020' (Chev 2500 rear bumper — 2020+)
// ═══════════════════════════════════════════════════════════════
function gmHDPickup2020Bumper(id, yr_from, yr_to, make, model, label, frontModelBase, ggModelBase, rearModelBase) {
  const hookChoices = [
    {val:'none',    label:'No Hooks'},
    {val:'sw1b',    label:'Monster Hooks Swivel Hook — Satin Black (+$500)',         sub:'MH-SW1B × 2'},
    {val:'sw1c',    label:'Monster Hooks Swivel Hook — Chrome Plated (+$600)',        sub:'MH-SW1C × 2'},
    {val:'sw1s',    label:'Monster Hooks Swivel Hook — Silver Powder Coat (+$500)',   sub:'MH-SW1S × 2'},
    {val:'sw1a',    label:'Monster Hooks Swivel Hook — Raw Aluminum (+$500)',         sub:'MH-SW1A × 2'},
    {val:'sw1r',    label:'Monster Hooks Swivel Hook — Candy Red (+$500)',            sub:'MH-SW1R × 2'},
    {val:'rs78xlb', label:'Monster Hooks Reaper Hook (+$350)',                        sub:'MH-RS78XLB × 2'},
  ];
  const wingLightChoices = (qty)=>[
    {val:'none',          label:`No Lights — Cutout${qty>1?'s':''} Included`},
    {val:'flood',         label:`(${qty}) 4" Rigid E-Series Flood (+$${qty*310})`,         sub:`RIG104113 × ${qty}`},
    {val:'spot',          label:`(${qty}) 4" Rigid E-Series Spot (+$${qty*310})`,          sub:`RIG104213 × ${qty}`},
    {val:'midnight-spot', label:`(${qty}) 4" Rigid E-Series Midnight Spot (+$${qty*310})`, sub:`RIG104213BLK × ${qty}`},
  ];
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];
  const srLightChoices = (qty)=>[
    {val:'none',       label:'No Light Bars'},
    {val:'sr-midnight',label:`(${qty}) 20" SR-Series Midnight Edition PRO — Hybrid/Spot (+$${qty*670})`, sub:`RIG920214BLK × ${qty}`},
    {val:'sr-combo',   label:`(${qty}) 20" SR-Series PRO — Spot/Flood Combo (+$${qty*670})`,             sub:`RIG920314 × ${qty}`},
    {val:'sr-driving', label:`(${qty}) 20" SR-Series PRO — Spot/Driving Combo (+$${qty*780})`,           sub:`RIG921314 × ${qty}`},
  ];

  // GG P/N: sq-solid-2 = Sq. ×2 no cutouts, sq-lights-2 = Sq. ×2 w/light bar cutouts
  const ggPN = (config, clevis) => {
    const cv = clevis ? '1' : '0';
    if(config==='sq-solid-2')  return `KLM-${ggModelBase}-0121200000${cv}`;
    if(config==='sq-lights-2') return `KLM-${ggModelBase}-0222200000${cv}`;
    return null;
  };

  const hasFrontPos = (sel)=>['front','front-rear'].includes(sel['bumper-position']);
  const hasRearPos  = (sel)=>!!rearModelBase&&['rear','front-rear'].includes(sel['bumper-position']);

  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Front & rear bumpers with accessories'}],
    steps:[
      // ── Bumper Position ──────────────────────────────────────────
      {key:'bumper-position', label:'Bumper Position', badge:'req',
       condition:()=>true,
       choices:()=>{
         const opts=[{val:'front', label:'Front Bumper Only'}];
         if(rearModelBase){
           opts.push({val:'rear',      label:'Rear Bumper Only'});
           opts.push({val:'front-rear',label:'Front + Rear Bumper'});
         }
         return opts;
       },
      },

      // ══ FRONT BUMPER PATH ═════════════════════════════════════════
      {key:'front-series', label:'Front Bumper Series', badge:'req',
       condition:(sel)=>hasFrontPos(sel),
       choices:()=>[
         {val:'alpha', label:'Alpha Series', sub:'Winch-ready center — can add Commander Grille Guard'},
         {val:'delta', label:'Delta Series', sub:'Center section with 20" light bar cutout'},
       ],
      },
      // GG — Alpha only; sq-solid-2 = no cutouts, sq-lights-2 = w/light bar cutouts
      {key:'gg-config', label:'Commander Grille Guard', badge:'opt',
       condition:(sel)=>hasFrontPos(sel)&&sel['front-series']==='alpha',
       choices:()=>[
         {val:'none',        label:'No Grille Guard'},
         {val:'sq-solid-2',  label:'Commander Grille Guard — Square × 2, No Light Bar Cutouts (+$1,100)',    sub:`KLM-${ggModelBase}-01212000000 (smooth face) / ...001 (clevis)`},
         {val:'sq-lights-2', label:'Commander Grille Guard — Square × 2 w/ Light Bar Cutouts (+$1,100)',     sub:`KLM-${ggModelBase}-02222000000 (smooth face) / ...001 (clevis)`},
       ],
      },
      // GG clevis hook mounts
      {key:'gg-clevis', label:'Grille Guard Hook Mounts', badge:'req',
       condition:(sel)=>hasFrontPos(sel)&&(sel['gg-config']==='sq-solid-2'||sel['gg-config']==='sq-lights-2'),
       choices:()=>[
         {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
         {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the grille guard'},
       ],
      },
      // Finish — after series + GG/clevis confirmed
      {key:'front-finish', label:'Bumper Finish', badge:'req',
       condition:(sel)=>{
         if(!hasFrontPos(sel)||!sel['front-series']) return false;
         if(sel['front-series']==='alpha'&&!sel['gg-config']) return false;
         if((sel['gg-config']==='sq-solid-2'||sel['gg-config']==='sq-lights-2')&&!sel['gg-clevis']) return false;
         return true;
       },
       choices:()=>finishChoices,
      },
      // License plate bracket
      {key:'front-lp', label:'License Plate Bracket', badge:'opt',
       condition:(sel)=>hasFrontPos(sel)&&!!sel['front-finish'],
       choices:()=>[
         {val:'no',  label:'No License Plate Bracket'},
         {val:'yes', label:'Yes — Add License Plate Bracket', sub:'31910 — Honeycomb Mesh, No Charge'},
       ],
      },
      // Alpha — winch accessory (only when no GG)
      {key:'alpha-winch-acc', label:'Winch', badge:'opt',
       condition:(sel)=>hasFrontPos(sel)&&sel['front-series']==='alpha'&&sel['gg-config']==='none',
       choices:()=>[
         {val:'none',    label:'No Winch'},
         {val:'war97740',label:'Warn 16.5ti — Hawse Fairlead, Synthetic Rope (+$3,350)', sub:'WAR97740'},
         {val:'war68801',label:'Warn 16.5ti — Roller Fairlead, Steel Cable (+$3,015)',   sub:'WAR68801'},
       ],
      },
      // Delta — 20" center light bar
      {key:'delta-center', label:'Center Section — Light Bar', badge:'opt',
       condition:(sel)=>hasFrontPos(sel)&&sel['front-series']==='delta'&&!!sel['front-finish'],
       choices:()=>[
         {val:'none',       label:'No Center Light Bar — Cutout Included'},
         {val:'e-series',   label:'20" Rigid E-Series Spot/Flood Combo (+$860)',      sub:'RIG120313'},
         {val:'e-midnight', label:'20" Rigid E-Series Midnight Edition Spot (+$860)', sub:'RIG120213BLK'},
       ],
      },
      // GG — SR Series light bars (only for sq-lights-2, qty=2)
      {key:'gg-light-bars', label:'Grille Guard — Light Bars', badge:'opt',
       condition:(sel)=>hasFrontPos(sel)&&sel['gg-config']==='sq-lights-2'&&!!sel['front-finish'],
       choices:()=>srLightChoices(2),
      },
      // Outer wing lights (4 cutouts)
      {key:'front-wing-lights', label:'Outer Wing Lights', badge:'opt',
       condition:(sel)=>hasFrontPos(sel)&&!!sel['front-finish'],
       choices:()=>wingLightChoices(4),
      },
      // Front hooks (+ locking pins when GG + clevis)
      {key:'front-hooks', label:'Hooks', badge:'opt',
       condition:(sel)=>hasFrontPos(sel)&&!!sel['front-finish'],
       choices:()=>hookChoices,
      },

      // ══ REAR BUMPER PATH ══════════════════════════════════════════
      {key:'rear-series', label:'Rear Bumper Series', badge:'req',
       condition:(sel)=>hasRearPos(sel),
       choices:()=>[
         {val:'bravo-smooth', label:'Bravo Series — Smooth Face',     sub:'w/Parking Sensors, Stock Width'},
         {val:'bravo-clevis', label:'Bravo Series — With Clevis Ears', sub:'w/Parking Sensors, Stock Width'},
         {val:'delta',        label:'Delta Series',                     sub:'w/Parking Sensors, Stock Width'},
       ],
      },
      {key:'rear-finish', label:'Rear Bumper Finish', badge:'req',
       mirror:'front-finish',
       condition:(sel)=>hasRearPos(sel)&&!!sel['rear-series'],
       choices:()=>finishChoices,
      },
      {key:'rear-lights', label:'Rear Bumper Lights', badge:'opt',
       mirror:'front-wing-lights',
       condition:(sel)=>hasRearPos(sel)&&!!sel['rear-finish'],
       choices:()=>wingLightChoices(2),
      },
      {key:'rear-hooks', label:'Rear Bumper Hooks', badge:'opt',
       mirror:'front-hooks',
       condition:(sel)=>hasRearPos(sel)&&!!sel['rear-finish']&&(sel['rear-series']==='bravo-clevis'||sel['rear-series']==='delta'),
       choices:()=>hookChoices,
      },
    ],
    buildParts:(kit,sel)=>{
      const parts=[];
      const hookPN={sw1b:'MH-SW1B',sw1c:'MH-SW1C',sw1s:'MH-SW1S',sw1a:'MH-SW1A',sw1r:'MH-SW1R',rs78xlb:'MH-RS78XLB'};
      const wingPN={flood:'RIG104113',spot:'RIG104213','midnight-spot':'RIG104213BLK'};
      const bp=sel['bumper-position']||'';

      // ── FRONT ──────────────────────────────────────────────────
      if(hasFrontPos(sel)){
        // Front bumper
        const scCode=sel['front-series']==='alpha'?'02':'04';
        parts.push({section:'Front Bumper',pn:`KLM-${frontModelBase}-001${scCode}0000`,qty:1});

        // Grille guard
        const gg=sel['gg-config'];
        const clevis=sel['gg-clevis']==='clevis';
        const ggpn=ggPN(gg,clevis);
        if(ggpn) parts.push({section:'Grille Guard',pn:ggpn,qty:1});

        // GG light bars (only for sq-lights-2, qty=2)
        if(gg==='sq-lights-2'){
          const srMap={'sr-midnight':'RIG920214BLK','sr-combo':'RIG920314','sr-driving':'RIG921314'};
          if(srMap[sel['gg-light-bars']]) parts.push({section:'Grille Guard Lights',pn:srMap[sel['gg-light-bars']],qty:2});
        }

        // Winch
        if(sel['alpha-winch-acc']==='war97740') parts.push({section:'Winch',pn:'WAR97740',qty:1});
        if(sel['alpha-winch-acc']==='war68801') parts.push({section:'Winch',pn:'WAR68801',qty:1});

        // Delta center light
        const dcMap={'e-series':'RIG120313','e-midnight':'RIG120213BLK'};
        if(dcMap[sel['delta-center']]) parts.push({section:'Bumper Lights',pn:dcMap[sel['delta-center']],qty:1});

        // Outer wing lights (qty 4)
        if(wingPN[sel['front-wing-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['front-wing-lights']],qty:4});

        // License plate
        if(sel['front-lp']==='yes') parts.push({section:'Accessories',pn:'31910',qty:1});

        // Hooks + locking pins (when GG + clevis)
        const fh=sel['front-hooks'];
        if(fh&&fh!=='none'&&hookPN[fh]){
          parts.push({section:'Hooks',pn:hookPN[fh],qty:2});
          if(gg&&gg!=='none'&&sel['gg-clevis']==='clevis') parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }

      // ── REAR ───────────────────────────────────────────────────
      if(rearModelBase&&['rear','front-rear'].includes(bp)){
        const rSuffix={'bravo-smooth':'101030000','bravo-clevis':'101030001','delta':'101040000'};
        const rsuf=rSuffix[sel['rear-series']];
        if(rsuf) parts.push({section:'Rear Bumper',pn:`KLM-${rearModelBase}-${rsuf}`,qty:1});
        if(wingPN[sel['rear-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['rear-lights']],qty:2});
        const rh=sel['rear-hooks'];
        if(rh&&rh!=='none'&&hookPN[rh]){
          parts.push({section:'Hooks',pn:hookPN[rh],qty:2});
          if(sel['rear-series']==='bravo-clevis') parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }

      return parts;
    },
  };
}


// ═══════════════════════════════════════════════════════════════
// Helper — GM 2500/3500 HD Pickup Bumper Platform (2015-2019)
// Alpha series only; Sq. ×2 grille guard only (smooth or clevis)
// hasWideEndCap : true for Chevrolet (1.75" wide option available)
//                false for GMC (stock width only)
// frontModelBase: e.g. '400002015' (Chev Silverado 2500)
// ggModelBase   : e.g. '200002015' (Chev Silverado 2500 GG)
// rearModelBase : e.g. '400002015' (Chev Silverado 2500 rear)
// ═══════════════════════════════════════════════════════════════
function gmHDPickup2015Bumper(id, yr_from, yr_to, make, model, label, frontModelBase, ggModelBase, rearModelBase, hasWideEndCap) {
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];
  const hasFrontPos = (sel)=>['front','front-rear'].includes(sel['bumper-position']);
  const hasRearPos  = (sel)=>!!rearModelBase&&['rear','front-rear'].includes(sel['bumper-position']);

  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Alpha series front & rear bumpers — Sq. ×2 grille guard available'}],
    steps:[
      // Bumper Position
      {key:'bumper-position', label:'Bumper Position', badge:'req',
       condition:()=>true,
       choices:()=>{
         const opts=[{val:'front', label:'Front Bumper Only'}];
         if(rearModelBase){
           opts.push({val:'rear',       label:'Rear Bumper Only'});
           opts.push({val:'front-rear', label:'Front + Rear Bumper'});
         }
         return opts;
       },
      },
      // Parking Sensors — one step drives both front and rear P/N prefix
      {key:'parking-sensors', label:'Parking Sensors', badge:'req',
       condition:(sel)=>!!sel['bumper-position'],
       choices:()=>[
         {val:'yes', label:'With Factory Parking Sensors', sub:'Vehicle has factory parking sensors — select this to ensure correct bumper variant'},
         {val:'no',  label:'No Parking Sensors'},
       ],
      },
      // Front center section (Alpha Light or Alpha Winch)
      {key:'front-series', label:'Front Bumper — Center Section', badge:'req',
       condition:(sel)=>hasFrontPos(sel)&&!!sel['parking-sensors'],
       choices:()=>[
         {val:'light', label:'Alpha Series — Light Center', sub:'4" light bar cutout center section'},
         {val:'winch', label:'Alpha Series — Winch Center', sub:'Winch-ready center — compatible with Sq. ×2 grille guard'},
       ],
      },
      // End cap width — Chevrolet only (GMC is stock only)
      {key:'end-caps', label:'Front End Caps', badge:'req',
       condition:(sel)=>hasFrontPos(sel)&&!!sel['front-series']&&hasWideEndCap,
       choices:()=>[
         {val:'stock', label:'Stock Width End Caps'},
         {val:'wide',  label:'1.75" Wide End Caps', sub:'Adds 1.75" to each side for a wider stance'},
       ],
      },
      // Grille Guard — Sq. ×2 only (smooth or clevis)
      {key:'gg-config', label:'Commander Grille Guard', badge:'opt',
       condition:(sel)=>hasFrontPos(sel)&&!!sel['front-series']&&(!hasWideEndCap||!!sel['end-caps']),
       choices:()=>[
         {val:'none',       label:'No Grille Guard'},
         {val:'sq2-smooth', label:'Commander Grille Guard — Sq. ×2, Smooth Face (+$1,100)',   sub:`KLM-${ggModelBase}-01111000000`},
         {val:'sq2-clevis', label:'Commander Grille Guard — Sq. ×2, w/Clevis Ears (+$1,100)', sub:`KLM-${ggModelBase}-01111000001`},
       ],
      },
      // Front Finish
      {key:'front-finish', label:'Front Bumper Finish', badge:'req',
       condition:(sel)=>hasFrontPos(sel)&&!!sel['front-series']&&(!hasWideEndCap||!!sel['end-caps'])&&sel['gg-config']!==undefined,
       choices:()=>finishChoices,
      },
      // Rear Finish (mirrors front when both included)
      {key:'rear-finish', label:'Rear Bumper Finish', badge:'req',
       mirror:'front-finish',
       condition:(sel)=>hasRearPos(sel)&&!!sel['parking-sensors'],
       choices:()=>finishChoices,
      },
    ],
    buildParts:(kit,sel)=>{
      const parts=[];
      const bp=sel['bumper-position']||'';
      const ps=sel['parking-sensors']==='yes';
      const psPfx=ps?'001':'002';
      const rpsPfx=ps?'101':'102';

      if(hasFrontPos(sel)&&sel['front-series']){
        const sc=sel['front-series']==='winch'?'02':'01';
        const wd=hasWideEndCap&&sel['end-caps']==='wide'?'1700':'0000';
        parts.push({section:'Front Bumper',pn:`KLM-${frontModelBase}-${psPfx}${sc}${wd}-02`,qty:1});
        const ggMap={
          'sq2-smooth':`KLM-${ggModelBase}-01111000000`,
          'sq2-clevis':`KLM-${ggModelBase}-01111000001`,
        };
        if(ggMap[sel['gg-config']]) parts.push({section:'Grille Guard',pn:ggMap[sel['gg-config']],qty:1});
      }

      if(rearModelBase&&['rear','front-rear'].includes(bp)){
        parts.push({section:'Rear Bumper',pn:`KLM-${rearModelBase}-${rpsPfx}000000-02`,qty:1});
      }

      return parts;
    },
  };
}

// ═══════════════════════════════════════════════════════════════
// Helper — GM Silverado 4500/5500/6500 CC Bumper Platform
// ═══════════════════════════════════════════════════════════════
function gmSilveradoCCBumper(id, yr_from, yr_to, make, model, label, frontModelBase, ggModelBase, rearModelBase) {
  const hookChoices = [
    {val:'none',    label:'No Hooks'},
    {val:'sw1b',    label:'Monster Hooks Swivel Hook — Satin Black (+$500)',         sub:'MH-SW1B × 2'},
    {val:'sw1c',    label:'Monster Hooks Swivel Hook — Chrome Plated (+$600)',        sub:'MH-SW1C × 2'},
    {val:'sw1s',    label:'Monster Hooks Swivel Hook — Silver Powder Coat (+$500)',   sub:'MH-SW1S × 2'},
    {val:'sw1a',    label:'Monster Hooks Swivel Hook — Raw Aluminum (+$500)',         sub:'MH-SW1A × 2'},
    {val:'sw1r',    label:'Monster Hooks Swivel Hook — Candy Red (+$500)',            sub:'MH-SW1R × 2'},
    {val:'rs78xlb', label:'Monster Hooks Reaper Hook (+$350)',                        sub:'MH-RS78XLB × 2'},
  ];
  const wingLightChoices = (qty)=>[
    {val:'none',          label:`No Lights — Cutout${qty>1?'s':''} Included`},
    {val:'flood',         label:`(${qty}) 4" Rigid E-Series Flood (+$${qty*310})`,         sub:`RIG104113 × ${qty}`},
    {val:'spot',          label:`(${qty}) 4" Rigid E-Series Spot (+$${qty*310})`,          sub:`RIG104213 × ${qty}`},
    {val:'midnight-spot', label:`(${qty}) 4" Rigid E-Series Midnight Spot (+$${qty*310})`, sub:`RIG104213BLK × ${qty}`},
  ];
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];
  const srLightChoices = (qty)=>[
    {val:'none',       label:'No Light Bars — Cutouts Included'},
    {val:'sr-midnight',label:`20" SR-Series Midnight Edition PRO — Hybrid/Spot (+$${qty*670})`,  sub:`RIG920214BLK × ${qty}`},
    {val:'sr-combo',   label:`20" SR-Series PRO — Spot/Flood Combo (+$${qty*670})`,              sub:`RIG920314 × ${qty}`},
    {val:'sr-driving', label:`20" SR-Series PRO — Spot/Driving Combo (+$${qty*780})`,            sub:`RIG921314 × ${qty}`},
  ];

  // GG P/Ns — no clevis variant on GM CC
  const ggPN = (config) => {
    if(config==='sq-solid')  return `KLM-${ggModelBase}-02424000000`;
    if(config==='sq-lights') return `KLM-${ggModelBase}-02323000000`;
    return null;
  };

  const hasFrontPos = (sel)=>['front','front-rear'].includes(sel['bumper-position']);
  const hasRearPos  = (sel)=>!!rearModelBase&&['rear','front-rear'].includes(sel['bumper-position']);

  const steps = [
    // ── Bumper Position ──────────────────────────────────────────
    {key:'bumper-position', label:'Bumper Position', badge:'req',
     condition:()=>true,
     choices:()=>{
       const opts=[{val:'front',label:'Front Bumper Only'}];
       if(rearModelBase){
         opts.push({val:'rear',      label:'Rear Bumper Only'});
         opts.push({val:'front-rear',label:'Front + Rear Bumper'});
       }
       return opts;
     },
    },

    // ══ FRONT BUMPER PATH ═════════════════════════════════════════
    {key:'front-series', label:'Front Bumper Series', badge:'req',
     condition:(sel)=>hasFrontPos(sel),
     choices:()=>[
       {val:'alpha', label:'Alpha Series', sub:'Winch-ready or light center — can add Commander Grille Guard'},
       {val:'bravo', label:'Bravo Series', sub:'Clean face design — smooth or clevis hook mounts'},
       {val:'delta', label:'Delta Series', sub:'Center section with 20" light bar cutout'},
     ],
    },
    // Alpha: Light Bar or Winch Center
    {key:'alpha-center-type', label:'Alpha Center Section', badge:'req',
     condition:(sel)=>hasFrontPos(sel)&&sel['front-series']==='alpha',
     choices:()=>[
       {val:'light', label:'Light Center', sub:'20" center section for E-Series light bar + 4" wing lights'},
       {val:'winch', label:'Winch Center', sub:'Winch-ready center mount'},
     ],
    },
    // Bravo: smooth face or clevis hook mounts (encoded in P/N)
    {key:'bravo-face', label:'Face Style', badge:'req',
     condition:(sel)=>hasFrontPos(sel)&&sel['front-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the bumper'},
     ],
    },
    // End cap width: Stock or 3.5" (DBL Design)
    {key:'front-endcap', label:'End Cap Width', badge:'req',
     condition:(sel)=>{
       if(!hasFrontPos(sel)||!sel['front-series']) return false;
       if(sel['front-series']==='alpha'&&!sel['alpha-center-type']) return false;
       if(sel['front-series']==='bravo'&&!sel['bravo-face']) return false;
       return true;
     },
     choices:()=>[
       {val:'stock', label:'Stock Width'},
       {val:'wide',  label:'3.5" Wide End Caps (DBL Design)'},
     ],
    },
    // GG — Alpha only; sq-solid or sq-lights (no clevis on GG)
    {key:'gg-config', label:'Commander Grille Guard', badge:'opt',
     condition:(sel)=>hasFrontPos(sel)&&sel['front-series']==='alpha'&&!!sel['alpha-center-type']&&!!sel['front-endcap'],
     choices:()=>[
       {val:'none',      label:'No Grille Guard'},
       {val:'sq-solid',  label:'Commander Grille Guard — Sq. × 2 Crossbars, No Light Cutouts (+$1,500)', sub:`KLM-${ggModelBase}-02424000000`},
       {val:'sq-lights', label:'Commander Grille Guard — Sq. × 2 Crossbars with 20" SR-Series Light Cutouts (+$1,500)', sub:`KLM-${ggModelBase}-02323000000`},
     ],
    },
    // Finish — shown after all pre-requisite series steps
    {key:'front-finish', label:'Bumper Finish', badge:'req',
     condition:(sel)=>{
       if(!hasFrontPos(sel)||!sel['front-series']||!sel['front-endcap']) return false;
       if(sel['front-series']==='alpha') return !!sel['alpha-center-type']&&!!sel['gg-config'];
       if(sel['front-series']==='bravo') return !!sel['bravo-face'];
       return true; // delta
     },
     choices:()=>finishChoices,
    },
    // License plate bracket
    {key:'front-lp', label:'License Plate Bracket', badge:'opt',
     condition:(sel)=>hasFrontPos(sel)&&!!sel['front-finish'],
     choices:()=>[
       {val:'no',  label:'No License Plate Bracket'},
       {val:'yes', label:'Yes — Add License Plate Bracket', sub:'31910 — Honeycomb Mesh, No Charge'},
     ],
    },
    // Center light bar — Alpha Light, Bravo, or Delta all have 20" center cutout
    {key:'alpha-light-bar', label:'Center Light Bar', badge:'opt',
     condition:(sel)=>{
       if(!hasFrontPos(sel)||!sel['front-finish']) return false;
       if(sel['front-series']==='bravo'||sel['front-series']==='delta') return true;
       return sel['front-series']==='alpha'&&sel['alpha-center-type']==='light';
     },
     choices:()=>[
       {val:'none',       label:'No Center Light Bar — Cutout Included'},
       {val:'e-series',   label:'20" Rigid E-Series Spot/Flood Combo (+$860)',       sub:'RIG120313'},
       {val:'e-midnight', label:'20" Rigid E-Series Midnight Edition Spot (+$860)',  sub:'RIG120213BLK'},
     ],
    },
    // Winch — Alpha Winch only
    {key:'alpha-winch-acc', label:'Winch', badge:'opt',
     condition:(sel)=>hasFrontPos(sel)&&sel['front-series']==='alpha'&&sel['alpha-center-type']==='winch'&&!!sel['front-finish'],
     choices:()=>[
       {val:'none',     label:'No Winch — Winch Center Included'},
       {val:'war97740', label:'Warn 16.5ti — Hawse Fairlead, Synthetic Rope (+$3,350)', sub:'WAR97740'},
       {val:'war68801', label:'Warn 16.5ti — Roller Fairlead, Steel Cable (+$3,015)',   sub:'WAR68801'},
     ],
    },
    // GG light bars — sq-lights only (2 × 20" SR-Series cutouts)
    {key:'gg-light-bars', label:'Grille Guard — Light Bar Selection', badge:'opt',
     condition:(sel)=>hasFrontPos(sel)&&sel['gg-config']==='sq-lights',
     choices:()=>srLightChoices(2),
    },
    // Outer wing lights — all series have 4" wing cutouts
    {key:'front-wing-lights', label:'Outer Wing Lights', badge:'opt',
     condition:(sel)=>hasFrontPos(sel)&&!!sel['front-finish'],
     choices:()=>wingLightChoices(4),
    },
    // Front hooks: Delta always; Bravo with clevis; Alpha with no GG
    {key:'front-hooks', label:'Hooks', badge:'opt',
     condition:(sel)=>hasFrontPos(sel)&&!!sel['front-finish']&&(
       sel['front-series']==='delta'||
       (sel['front-series']==='bravo'&&sel['bravo-face']==='clevis')||
       (sel['front-series']==='alpha'&&(!sel['gg-config']||sel['gg-config']==='none'))
     ),
     choices:()=>hookChoices,
    },

    // ══ REAR BUMPER PATH — Alpha only ════════════════════════════
    {key:'rear-pu-finish', label:'Rear Bumper Finish', badge:'req',
     mirror:'front-finish',
     condition:(sel)=>hasRearPos(sel),
     choices:()=>finishChoices,
    },
    {key:'rear-pu-hooks', label:'Rear Bumper Hooks', badge:'opt',
     condition:(sel)=>hasRearPos(sel)&&!!sel['rear-pu-finish'],
     choices:()=>hookChoices,
    },
  ];

  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Front & rear bumpers with accessories'}],
    steps,
    buildParts:(kit,sel)=>{
      const parts=[];
      const hookPN={sw1b:'MH-SW1B',sw1c:'MH-SW1C',sw1s:'MH-SW1S',sw1a:'MH-SW1A',sw1r:'MH-SW1R',rs78xlb:'MH-RS78XLB'};
      const wingPN={flood:'RIG104113',spot:'RIG104213','midnight-spot':'RIG104213BLK'};

      // ── FRONT ──────────────────────────────────────────────────
      if(hasFrontPos(sel)){
        const series=sel['front-series'];
        const ct=sel['alpha-center-type']||'light';
        const scMap={'alpha-light':'1','alpha-winch':'2','bravo':'3','delta':'4'};
        const sc=scMap[series==='alpha'?`alpha-${ct}`:series];
        if(sc&&sel['front-endcap']){
          const wide=sel['front-endcap']==='wide';
          const clevis=series==='bravo'&&sel['bravo-face']==='clevis';
          const wc=(wide?'350':'000')+(clevis?'1':'0');
          parts.push({section:'Front Bumper',pn:`KLM-${frontModelBase}-0020${sc}${wc}`,qty:1});
        }

        // Grille guard (no clevis on GM CC GG)
        const gg=sel['gg-config'];
        const ggpn=ggPN(gg);
        if(ggpn) parts.push({section:'Grille Guard',pn:ggpn,qty:1});

        // GG light bars (2 × SR-Series)
        if(gg==='sq-lights'){
          const srMap={'sr-midnight':'RIG920214BLK','sr-combo':'RIG920314','sr-driving':'RIG921314'};
          if(srMap[sel['gg-light-bars']]) parts.push({section:'Grille Guard Lights',pn:srMap[sel['gg-light-bars']],qty:2});
        }

        // Winch
        if(sel['alpha-winch-acc']==='war97740') parts.push({section:'Winch',pn:'WAR97740',qty:1});
        if(sel['alpha-winch-acc']==='war68801') parts.push({section:'Winch',pn:'WAR68801',qty:1});

        // Center light bar (Alpha Light, Bravo, or Delta)
        const dcMap={'e-series':'RIG120313','e-midnight':'RIG120213BLK'};
        if(dcMap[sel['alpha-light-bar']]) parts.push({section:'Bumper Lights',pn:dcMap[sel['alpha-light-bar']],qty:1});

        // Outer wing lights — all series, qty 4
        if(wingPN[sel['front-wing-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['front-wing-lights']],qty:4});

        // License plate
        if(sel['front-lp']==='yes') parts.push({section:'Accessories',pn:'31910',qty:1});

        // Front hooks + locking pins (Bravo clevis bumper only — no GG clevis on GM CC)
        const fh=sel['front-hooks'];
        if(fh&&fh!=='none'&&hookPN[fh]){
          parts.push({section:'Hooks',pn:hookPN[fh],qty:2});
          if(series==='bravo'&&sel['bravo-face']==='clevis') parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }

      // ── REAR — Alpha only ────────────────────────────────────────
      if(hasRearPos(sel)){
        parts.push({section:'Rear Bumper',pn:`KLM-${rearModelBase}-102000000`,qty:1});
        const rph=sel['rear-pu-hooks'];
        if(rph&&rph!=='none'&&hookPN[rph]){
          parts.push({section:'Hooks',pn:hookPN[rph],qty:2});
        }
      }

      return parts;
    },
  };
}

// Merges a bumper path into an existing suspension platform using 2-level category flow
// ═══════════════════════════════════════════════════════════════
// Helper — Dodge/RAM 2003-2009 2500/3500 Pickup Bumper Platform
// Front P/N: KLM-{frontModelBase}-002{sc}0{cv}
//   sc: '02'=Alpha-Winch, '03'=Bravo
//   cv: '000'=smooth, '001'=clevis  (Alpha always 000)
// Rear P/N: KLM-{rearModelBase}-10003{cv2}-02
//   cv2: '0000'=smooth, '0001'=clevis
// hasAlpha: true for 2006-2009 (Alpha Winch available); false for 2003-2005 (Bravo only)
// ═══════════════════════════════════════════════════════════════
function ramSDBumper2003(id, yr_from, yr_to, make, model, label, frontModelBase, rearModelBase, hasAlpha) {
  const hookChoices = [
    {val:'none',    label:'No Hooks'},
    {val:'sw1b',    label:'Monster Hooks Swivel Hook — Satin Black (+$500)',         sub:'MH-SW1B \xd7 2'},
    {val:'sw1c',    label:'Monster Hooks Swivel Hook — Chrome Plated (+$600)',        sub:'MH-SW1C \xd7 2'},
    {val:'sw1s',    label:'Monster Hooks Swivel Hook — Silver Powder Coat (+$500)',   sub:'MH-SW1S \xd7 2'},
    {val:'sw1a',    label:'Monster Hooks Swivel Hook — Raw Aluminum (+$500)',         sub:'MH-SW1A \xd7 2'},
    {val:'sw1r',    label:'Monster Hooks Swivel Hook — Candy Red (+$500)',            sub:'MH-SW1R \xd7 2'},
    {val:'rs78xlb', label:'Monster Hooks Reaper Hook (+$350)',                             sub:'MH-RS78XLB \xd7 2'},
  ];
  const wingLightChoices = (qty)=>[
    {val:'none',          label:`No Lights — Cutout${qty>1?'s':''} Included`},
    {val:'flood',         label:`(${qty}) 4" Rigid E-Series Flood (+$${qty*310})`,         sub:`RIG104113 \xd7 ${qty}`},
    {val:'spot',          label:`(${qty}) 4" Rigid E-Series Spot (+$${qty*310})`,          sub:`RIG104213 \xd7 ${qty}`},
    {val:'midnight-spot', label:`(${qty}) 4" Rigid E-Series Midnight Spot (+$${qty*310})`, sub:`RIG104213BLK \xd7 ${qty}`},
  ];
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];
  const hasFrontPos = (sel)=>['front','front-rear-pu'].includes(sel['bumper-position']);
  const hasRearPos  = (sel)=>!!rearModelBase&&['rear-pu','front-rear-pu'].includes(sel['bumper-position']);
  const steps = [
    {key:'bumper-position', label:'Bumper Position', badge:'req',
     condition:()=>true,
     choices:()=>{
       const opts=[{val:'front',label:'Front Bumper Only'}];
       if(rearModelBase){
         opts.push({val:'rear-pu',       label:'Rear Bumper Only'});
         opts.push({val:'front-rear-pu', label:'Front + Rear Bumper'});
       }
       return opts;
     },
    },
    {key:'front-series', label:'Front Bumper Series', badge:'req',
     condition:(sel)=>hasFrontPos(sel),
     choices:()=>{
       const opts=[];
       if(hasAlpha) opts.push({val:'alpha', label:'Alpha Series', sub:'Winch-ready center'});
       opts.push({val:'bravo', label:'Bravo Series', sub:'Clean face — smooth or clevis hook mounts'});
       return opts;
     },
    },
    {key:'bravo-face', label:'Face Style', badge:'req',
     condition:(sel)=>sel['front-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts', sub:'Required for Monster Hooks on the bumper'},
     ],
    },
    {key:'front-finish', label:'Bumper Finish', badge:'req',
     condition:(sel)=>{
       if(!hasFrontPos(sel)||!sel['front-series']) return false;
       if(sel['front-series']==='bravo'&&!sel['bravo-face']) return false;
       return true;
     },
     choices:()=>finishChoices,
    },
    {key:'front-lp', label:'License Plate Bracket', badge:'opt',
     condition:(sel)=>!!sel['front-finish'],
     choices:()=>[
       {val:'no',  label:'No License Plate Bracket'},
       {val:'yes', label:'Yes — Add License Plate Bracket', sub:'31910 — Honeycomb Mesh, No Charge'},
     ],
    },
    {key:'alpha-winch-acc', label:'Winch', badge:'opt',
     condition:(sel)=>sel['front-series']==='alpha'&&!!sel['front-finish'],
     choices:()=>[
       {val:'none',     label:'No Winch — Winch Center Included'},
       {val:'war97740', label:'Warn 16.5ti — Hawse Fairlead, Synthetic Rope (+$3,350)', sub:'WAR97740'},
       {val:'war68801', label:'Warn 16.5ti — Roller Fairlead, Steel Cable (+$3,015)',   sub:'WAR68801'},
     ],
    },
    {key:'front-wing-lights', label:'Outer Wing Lights', badge:'opt',
     condition:(sel)=>!!sel['front-finish'],
     choices:()=>wingLightChoices(4),
    },
    {key:'front-hooks', label:'Hooks', badge:'opt',
     condition:(sel)=>!!sel['front-finish']&&(
       sel['front-series']==='alpha'||
       (sel['front-series']==='bravo'&&sel['bravo-face']==='clevis')
     ),
     choices:()=>hookChoices,
    },
    {key:'rear-pu-series', label:'Rear Bumper Series', badge:'req',
     condition:(sel)=>hasRearPos(sel),
     choices:()=>[{val:'bravo', label:'Bravo Series', sub:'Smooth face or clevis hook mounts'}],
    },
    {key:'rear-pu-face', label:'Rear Face Style', badge:'req',
     condition:(sel)=>hasRearPos(sel)&&sel['rear-pu-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Hook Mounts'},
       {val:'clevis', label:'With Clevis Hook Mounts'},
     ],
    },
    {key:'rear-pu-finish', label:'Rear Bumper Finish', badge:'req',
     mirror:'front-finish',
     condition:(sel)=>hasRearPos(sel)&&!!sel['rear-pu-face'],
     choices:()=>finishChoices,
    },
    {key:'rear-pu-lights', label:'Rear Bumper Lights', badge:'opt',
     mirror:'front-wing-lights',
     condition:(sel)=>!!sel['rear-pu-finish'],
     choices:()=>wingLightChoices(2),
    },
    {key:'rear-pu-hooks', label:'Rear Bumper Hooks', badge:'opt',
     mirror:'front-hooks',
     condition:(sel)=>!!sel['rear-pu-finish']&&sel['rear-pu-face']==='clevis',
     choices:()=>hookChoices,
    },
  ];
  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Front & rear bumpers with accessories'}],
    steps,
    buildParts:(kit,sel)=>{
      const parts=[];
      const hookPN={sw1b:'MH-SW1B',sw1c:'MH-SW1C',sw1s:'MH-SW1S',sw1a:'MH-SW1A',sw1r:'MH-SW1R',rs78xlb:'MH-RS78XLB'};
      const wingPN={flood:'RIG104113',spot:'RIG104213','midnight-spot':'RIG104213BLK'};
      if(hasFrontPos(sel)){
        const series=sel['front-series'];
        const sc=series==='alpha'?'02':'03';
        const cv=series==='bravo'&&sel['bravo-face']==='clevis'?'001':'000';
        parts.push({section:'Front Bumper',pn:`KLM-${frontModelBase}-002${sc}0${cv}`,qty:1});
        if(sel['alpha-winch-acc']==='war97740') parts.push({section:'Winch',pn:'WAR97740',qty:1});
        if(sel['alpha-winch-acc']==='war68801') parts.push({section:'Winch',pn:'WAR68801',qty:1});
        if(wingPN[sel['front-wing-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['front-wing-lights']],qty:4});
        if(sel['front-lp']==='yes') parts.push({section:'Accessories',pn:'31910',qty:1});
        const fh=sel['front-hooks'];
        if(fh&&fh!=='none'&&hookPN[fh]){
          parts.push({section:'Hooks',pn:hookPN[fh],qty:2});
          if(series==='bravo'&&sel['bravo-face']==='clevis') parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }
      if(hasRearPos(sel)){
        const rf=sel['rear-pu-face'];
        const cv2=rf==='clevis'?'0001':'0000';
        parts.push({section:'Rear Bumper',pn:`KLM-${rearModelBase}-10003${cv2}-02`,qty:1});
        if(wingPN[sel['rear-pu-lights']]) parts.push({section:'Bumper Lights',pn:wingPN[sel['rear-pu-lights']],qty:2});
        const rph=sel['rear-pu-hooks'];
        if(rph&&rph!=='none'&&hookPN[rph]){
          parts.push({section:'Hooks',pn:hookPN[rph],qty:2});
          if(rf==='clevis') parts.push({section:'Hooks',pn:'61000',qty:2});
        }
      }
      return parts;
    },
  };
}

// Accepts optional 5th arg bumperObj to use a pre-built bumper platform (e.g. ramSDBumper)
// ─────────────────────────────────────────────────────────────
// withAccessories — adds an 'Accessories' product category to any platform
// cfg = { dss:[{pn, note, drive?, driveLabel?}], arms?:{pn, note} }
// If entry already has a 'category' step (from withBumpers), appends 'accessories' choice.
// Otherwise creates a new category step gating existing suspension steps.
// ─────────────────────────────────────────────────────────────
function withAccessories(entry, cfg) {
  const hasDSS       = cfg.dss && cfg.dss.length > 0;
  const hasArms      = !!cfg.arms;
  const multiDrv     = hasDSS && cfg.dss.length > 1;
  const hasFlareCaps = !!(cfg.flareCaps && cfg.flareCaps.length > 0);
  const hasHR        = !!(cfg.headacheRack && cfg.headacheRack.variants && cfg.headacheRack.variants.length > 0);
  const hasHitch     = !!cfg.hitch;

  const accSteps = [];

  // What accessory?
  const accTypeChoices = [];
  if(hasDSS)             accTypeChoices.push({val:'dss',           label:'Dual Steering Stabilizer Bracket',        sub:'Bracket kit with optional shocks and finish choice'});
  if(hasArms)            accTypeChoices.push({val:'arms',          label:'Fabricated Radius Arms',                  sub:'Bolt-on fabricated radius arms with finish choice'});
  if(hasDSS && hasArms)  accTypeChoices.push({val:'dss+arms',      label:'DSS Bracket + Radius Arms',               sub:'Both steering stabilizer bracket and fabricated radius arms'});
  if(hasFlareCaps)       accTypeChoices.push({val:'flare-caps',    label:'Fender Flare Caps',                       sub:'Front and/or rear injection-molded OE texture fender flare caps'});
  if(hasHR)              accTypeChoices.push({val:'headache-rack', label:'Headache Rack',                           sub:'Kelderman headache rack with 40" 360-Connect light cutout'});

  accSteps.push({
    key:'acc-type', label:'Accessory Type', badge:'req',
    condition:(sel)=>sel.category==='accessories',
    choices:()=>accTypeChoices,
  });

  // DSS drivetrain / lift-height selector (only when multiple bracket options)
  if(multiDrv) {
    accSteps.push({
      key:'acc-drive', label:cfg.driveStepLabel||'Drivetrain', badge:'req',
      condition:(sel)=>sel.category==='accessories'&&(sel['acc-type']==='dss'||sel['acc-type']==='dss+arms'),
      choices:()=>cfg.dss.map(d=>({val:d.drive, label:d.driveLabel||d.drive, sub:d.note||''})),
    });
  }

  // DSS shocks
  accSteps.push({
    key:'acc-dss-shock', label:'Steering Stabilizer Shocks', badge:'opt',
    condition:(sel)=>sel.category==='accessories'&&(sel['acc-type']==='dss'||sel['acc-type']==='dss+arms'),
    choices:()=>[
      {val:'none',   label:'No Shocks'},
      {val:'fox',    label:'Fox Steering Stabilizer Shocks — 985-24-068',               sub:'(2) Fox 985-24-068',                        parts:[{pn:'985-24-068',qty:2}]},
      {val:'raptor', label:'Kelderman-Raptor Steering Stabilizer Shocks — 10003382',   sub:'(2) Kelderman-Raptor 2.0 Monotube Shocks',  parts:[{pn:'10003382',qty:2}]},
    ],
  });

  // DSS finish
  accSteps.push({
    key:'acc-dss-finish', label:'DSS Bracket Finish', badge:'opt',
    default:'textured-black',
    condition:(sel)=>sel.category==='accessories'&&(sel['acc-type']==='dss'||sel['acc-type']==='dss+arms'),
    choices:()=>[
      {val:'bare-steel',     label:'Raw Metal / No Powder Coat'},
      {val:'textured-black', label:'Textured Black Powder Coat'},
      {val:'gloss-black',    label:'Gloss Black Powder Coat'},
      {val:'gloss-red',      label:'Gloss Red Powder Coat (+$50)'},
    ],
  });

  // Arms finish
  if(hasArms) {
    accSteps.push({
      key:'acc-arms-finish', label:'Radius Arms Finish', badge:'opt',
      default:'textured-black',
      condition:(sel)=>sel.category==='accessories'&&(sel['acc-type']==='arms'||sel['acc-type']==='dss+arms'),
      choices:()=>[
        {val:'bare-steel',     label:'Raw Metal / No Powder Coat'},
        {val:'textured-black', label:'Textured Black Powder Coat'},
        {val:'gloss-black',    label:'Gloss Black Powder Coat'},
        {val:'gloss-red',      label:'Gloss Red Powder Coat (+$100)'},
      ],
    });
  }

  // Fender flare caps selection
  if(hasFlareCaps) {
    accSteps.push({
      key:'acc-flare-caps', label:'Fender Flare Cap Selection', badge:'req',
      condition:(sel)=>sel.category==='accessories'&&sel['acc-type']==='flare-caps',
      choices:()=>cfg.flareCaps,
    });
  }

  // Headache rack model selection
  if(hasHR) {
    accSteps.push({
      key:'acc-hr-model', label:'Headache Rack', badge:'req',
      condition:(sel)=>sel.category==='accessories'&&sel['acc-type']==='headache-rack',
      choices:()=>cfg.headacheRack.variants.map(v=>({
        val:v.val, label:`${v.label} (+$2,500)`, sub:`${v.pn} — 40" 360-Connect light cutout included`, parts:[{pn:v.pn,qty:1}],
      })),
    });
    accSteps.push({
      key:'acc-hr-light', label:'40" 360-Connect Light Bar', badge:'opt',
      condition:(sel)=>sel.category==='accessories'&&sel['acc-type']==='headache-rack'&&!!sel['acc-hr-model'],
      choices:()=>[
        {val:'none', label:'No Light Bar — Cutout Included'},
        {val:'yes',  label:`40" Rigid 360-Connect Light Bar (+$2,000)`, sub:`${cfg.headacheRack.lightPN}`, parts:[{pn:cfg.headacheRack.lightPN,qty:1}]},
      ],
    });
  }

  // If no accessories to offer, return the platform unchanged — no category step needed
  if(accTypeChoices.length === 0 && !hasFlareCaps && !hasHitch) return entry;

  let newSteps;
  const existingCatStep = entry.steps.find(s=>s.key==='category');

  if(existingCatStep) {
    // Platform already wrapped by withBumpers — append 'accessories' to existing category choices
    newSteps = entry.steps.map(s=>{
      if(s.key!=='category') return s;
      const origChoices = s.choices;
      return Object.assign({},s,{
        choices:(...args)=>[...origChoices(...args),{val:'accessories',label:'Accessories',sub:'Quote a standalone DSS bracket, radius arms, or other accessories'}],
      });
    });
    newSteps = [...newSteps,...accSteps];
  } else {
    // Plain platform — create category step and gate existing suspension steps
    const catStep = {
      key:'category', label:'Product Category', badge:'req',
      condition:()=>true,
      choices:()=>[
        {val:'suspension',  label:'Air Suspension',  sub:'Configure an air suspension kit'},
        {val:'accessories', label:'Accessories',      sub:'Quote a standalone DSS bracket, radius arms, or other accessories'},
      ],
    };
    const suspSteps = entry.steps.map(s=>{
      const orig = s.condition||(()=>true);
      return Object.assign({},s,{condition:(sel)=>sel.category==='suspension'&&orig(sel)});
    });
    newSteps = [catStep,...suspSteps,...accSteps];
  }

  // Inject flareCaps as an optional step at the VERY END of all non-accessories paths
  // (Air Suspension, Bumpers, Air Suspension + Bumpers) — bypasses withBumpers isSusp gate
  if(hasFlareCaps) {
    newSteps = [...newSteps, {
      key:'flare-caps', label:'Fender Flare Caps', badge:'opt',
      default:'none',
      condition:(sel)=>!!sel.category && sel.category!=='accessories',
      choices:()=>cfg.flareCaps,
    }];
  }

  // Inject BFH hitch as a suspension-path step — visible only when Spare Tire Keeper ctrl selected
  const spareTireKeeperVals = ['alp4','alp4-console','alp4-dc','alp4-dc-console'];
  if(hasHitch) {
    newSteps = [...newSteps, {
      key:'bfh', label:'THE BFH — Upgraded Hitch Receiver', badge:'opt',
      default:'none',
      condition:(sel)=>sel.category==='suspension'&&spareTireKeeperVals.includes(sel.ctrl),
      choices:()=>[
        {val:'none', label:'No Upgraded Hitch Receiver'},
        {val:'yes',  label:'Add THE BFH Upgraded Hitch Receiver (10035358)',
         sub:'10035358 — Upgraded hitch receiver, required with Spare Tire Keeper controls kit',
         parts:[{pn:'10035358',qty:1}]},
      ],
    }];
  }

  const origBP = entry.buildParts;
  return Object.assign({},entry,{
    steps:newSteps,
    buildParts:(kit,sel)=>{
      if(sel.category==='accessories') {
        const parts=[];
        const wantsDSS = sel['acc-type']==='dss'||sel['acc-type']==='dss+arms';
        const wantsArms = sel['acc-type']==='arms'||sel['acc-type']==='dss+arms';
        if(wantsDSS) {
          const bracket = multiDrv ? cfg.dss.find(d=>d.drive===sel['acc-drive']) : cfg.dss[0];
          if(bracket) parts.push({section:'Dual Steering Stabilizer',pn:bracket.pn,qty:1});
          if(sel['acc-dss-shock']==='fox')    parts.push({section:'Shocks',pn:'985-24-068',qty:2});
          if(sel['acc-dss-shock']==='raptor') parts.push({section:'Shocks',pn:'10003382',qty:2});
          if(sel['acc-dss-finish']==='gloss-red') parts.push({section:'Dual Steering Stabilizer',pn:'Gloss-Red',qty:1});
        }
        if(wantsArms) {
          parts.push({section:'Radius Arms',pn:cfg.arms.pn,qty:1});
          if(sel['acc-arms-finish']==='gloss-red') parts.push({section:'Radius Arms',pn:'Gloss-Red',qty:2});
        }
        if(sel['acc-type']==='flare-caps') {
          const ch=(cfg.flareCaps||[]).find(c=>c.val===sel['acc-flare-caps']);
          if(ch&&ch.parts) ch.parts.forEach(p=>parts.push({section:'Fender Flare Caps',...p}));
        }
        if(sel['acc-type']==='headache-rack') {
          const v=(cfg.headacheRack&&cfg.headacheRack.variants||[]).find(v=>v.val===sel['acc-hr-model']);
          if(v) parts.push({section:'Headache Rack',pn:v.pn,qty:1});
          if(sel['acc-hr-light']==='yes') parts.push({section:'Headache Rack',pn:cfg.headacheRack.lightPN,qty:1});
        }
        return parts;
      }
      // Suspension / Bumpers / Suspension+Bumpers paths
      const parts = origBP(kit,sel);
      if(hasFlareCaps) {
        const ch=(cfg.flareCaps||[]).find(c=>c.val===sel['flare-caps']);
        if(ch&&ch.parts) ch.parts.forEach(p=>parts.push({section:'Fender Flare Caps',...p}));
      }
      if(hasHitch&&sel.bfh==='yes') parts.push({section:'Hitch',pn:'10035358',qty:1});
      return parts;
    },
  });
}

function withBumpers(entry, modelBase, hasStockWidth, rearType, bumperObj) {
  const bumper = bumperObj || fordSDBumper('_', null, null, '', '', '', modelBase, hasStockWidth, rearType);
  const categoryStep = {
    key:'category', label:'Product Category', badge:'req',
    condition:()=>true,
    choices:()=>[
      {val:'suspension',          label:'Air Suspension',              sub:'Configure an air suspension kit'},
      {val:'bumpers',             label:'Bumpers',                     sub:'Configure a front or rear bumper'},
      {val:'suspension+bumpers',  label:'Air Suspension + Bumpers',    sub:'Configure a lift kit and bumpers together in one quote'},
    ],
  };
  const isSusp = (sel)=>sel.category==='suspension'||sel.category==='suspension+bumpers';
  const isBump = (sel)=>sel.category==='bumpers'   ||sel.category==='suspension+bumpers';
  const suspSteps = entry.steps.map(s=>{
    const orig = s.condition||(()=>true);
    return Object.assign({},s,{condition:(sel)=>isSusp(sel)&&orig(sel)});
  });
  const bumpSteps = bumper.steps.map(s=>{
    const orig = s.condition||(()=>true);
    return Object.assign({},s,{condition:(sel)=>isBump(sel)&&orig(sel)});
  });
  // Suspension finish — shown at the end of the suspension path; doesn't affect P/Ns
  const suspFinishStep = {
    key:'susp-finish', label:'Suspension Finish', badge:'opt',
    default:'textured-black',
    condition:(sel)=>isSusp(sel)&&entry.steps.some(s=>!!sel[s.key]),
    choices:(kit,sel)=>{
      const is2stage = sel.rear==='2stage-hitch'||sel.rear==='2stage-nohitch'||sel['suspension-type']==='2stage-rear';
      if(is2stage) return [{val:'textured-black', label:'Textured Black Powder Coat'}];
      const isStockHeight = sel.height==='stock-1.5' || sel.height==='stock';
      const up = sel.scope==='front-only' ? 100 : sel.scope==='rear-only' ? 250 : (isStockHeight ? 350 : 500);
      return [
        {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
        {val:'textured-black', label:'Textured Black Powder Coat'},
        {val:'gloss-black',    label:'Gloss Black Powder Coat'},
        {val:'gloss-red',      label:`Gloss Red Powder Coat (+$${up})`},
      ];
    },
  };
  const origBP = entry.buildParts;
  return Object.assign({},entry,{
    steps:[categoryStep,...suspSteps,suspFinishStep,...bumpSteps],
    buildParts:(kit,sel)=>{
      if(sel.category==='bumpers') return bumper.buildParts(kit,sel);
      if(sel.category==='suspension+bumpers') return [...origBP(kit,sel),...bumper.buildParts(kit,sel)];
      return origBP(kit,sel);
    },
  });
}

// ═══════════════════════════════════════════════════════════════
// 2011-2016 Ford Super Duty Pickup Bumper Platform Generator
// modelBase     : e.g. '402021011' (F-250), '402022011' (F-350), '402023011' (F-450/F-550)
// hasStockWidth : true for F-250/F-350 (stock + 1.75" wide); false for F-450 (fixed width per series)
// rearType      : 'pickup' | 'cc' | 'both'
// ═══════════════════════════════════════════════════════════════
function fordSD11Bumper(id, yr_from, yr_to, make, model, label, modelBase, hasStockWidth, rearType) {
  const hookChoices = [
    {val:'none',    label:'No Hooks'},
    {val:'sw1b',    label:'Monster Hooks Swivel Hook — Satin Black (+$500)',         sub:'MH-SW1B × 2',    parts:[{pn:'MH-SW1B',qty:2}]},
    {val:'sw1c',    label:'Monster Hooks Swivel Hook — Chrome Plated (+$600)',        sub:'MH-SW1C × 2',    parts:[{pn:'MH-SW1C',qty:2}]},
    {val:'sw1s',    label:'Monster Hooks Swivel Hook — Silver Powder Coat (+$500)',   sub:'MH-SW1S × 2',    parts:[{pn:'MH-SW1S',qty:2}]},
    {val:'sw1a',    label:'Monster Hooks Swivel Hook — Raw Aluminum (+$500)',         sub:'MH-SW1A × 2',    parts:[{pn:'MH-SW1A',qty:2}]},
    {val:'sw1r',    label:'Monster Hooks Swivel Hook — Candy Red (+$500)',            sub:'MH-SW1R × 2',    parts:[{pn:'MH-SW1R',qty:2}]},
    {val:'rs78xlb', label:'Monster Hooks Reaper Hook (+$350)',                        sub:'MH-RS78XLB × 2', parts:[{pn:'MH-RS78XLB',qty:2}]},
  ];
  const wingLightChoices = (qty)=>[
    {val:'none',          label:`No Lights — Cutout${qty>1?'s':''} Included`},
    {val:'flood',         label:`(${qty}) 4" Rigid E-Series Flood (+$${qty*310})`,         sub:`RIG104113 × ${qty}`,    parts:[{pn:'RIG104113',qty}]},
    {val:'spot',          label:`(${qty}) 4" Rigid E-Series Spot (+$${qty*310})`,          sub:`RIG104213 × ${qty}`,    parts:[{pn:'RIG104213',qty}]},
    {val:'midnight-spot', label:`(${qty}) 4" Rigid E-Series Midnight Spot (+$${qty*310})`, sub:`RIG104213BLK × ${qty}`, parts:[{pn:'RIG104213BLK',qty}]},
  ];
  const finishChoices = [
    {val:'bare-steel',     label:'Bare Steel / No Powder Coat'},
    {val:'primer',         label:'Primer Powder Coat'},
    {val:'textured-black', label:'Textured Black Powder Coat'},
  ];

  // ── P/N builders ─────────────────────────────────────────────
  // Front: KLM-{modelBase}-002{seriesCode}{wideFlag}{wideMid}{clevis}-02
  // series codes: light=01, winch=02, bravo=03
  // wideFlag: 0=stock, 1=wide 1.75"; wideMid: 00 (stock) or 70 (wide 1.75")
  // clevis: 0 or 1 (Bravo only)
  const frontPN = (series, wide, clevis) => {
    const sc = {light:'1',winch:'2',bravo:'3'}[series];
    const wF = wide?'1':'0', wM = wide?'70':'00', cv = clevis?'1':'0';
    return `KLM-${modelBase}-002${0}${sc}${wF}${wM}${cv}-02`;
  };
  // Rear: KLM-{modelBase}-10{sensors}0{serCode}000{clevis}-02
  // sensors: 1=w/sensors, 2=no sensors
  // serCode: 0=Alpha, 3=Bravo
  const rearPN = (sensors, series, clevis) => {
    const sc = sensors?'1':'2', serCode = series==='bravo'?'3':'0', cv = (series==='bravo'&&clevis)?'1':'0';
    const sfx = (!sensors && series==='bravo') ? '' : '-02';
    return `KLM-${modelBase}-10${sc}0${serCode}000${cv}${sfx}`;
  };

  // For F-450 (hasStockWidth=false): width is fixed per series
  const autoWide = (series) => series!=='winch'; // winch=stock, light/bravo=wide
  const getWide  = (sel) => hasStockWidth ? sel['front-endcap']==='wide' : autoWide(sel['front-series']);

  const hasFront = (bp) => bp==='front'||bp==='front-rear';
  const hasRear  = (bp) => bp==='rear' ||bp==='front-rear';

  const steps = [
    {key:'bumper-position', label:'Bumper Position', badge:'req',
     condition:()=>true,
     choices:()=>{
       const opts = [{val:'front',label:'Front Bumper Only'}];
       if(rearType==='pickup'||rearType==='both'){opts.push({val:'rear',label:'Rear Bumper Only'});opts.push({val:'front-rear',label:'Front + Rear Bumpers'});}
       return opts;
     },
    },

    // ── FRONT ─────────────────────────────────────────────────
    {key:'front-series', label:'Front Bumper Series', badge:'req',
     condition:(sel)=>hasFront(sel['bumper-position']),
     choices:()=>[
       {val:'light', label:'Alpha Series — Light Center',  sub:'20" light bar cutout center section'},
       {val:'winch', label:'Alpha Series — Winch Center',  sub:'Winch-ready center mount'},
       {val:'bravo', label:'Bravo Series — Smooth/Clevis', sub:'20" light bar cutout center section'},
     ],
    },
    {key:'front-center-winch', label:'Center Section — Winch', badge:'opt',
     condition:(sel)=>sel['front-series']==='winch',
     choices:()=>[
       {val:'none',     label:'No Winch — Winch Cutout Included'},
       {val:'war97740', label:'Warn 16.5ti — Hawse Fairlead, Synthetic Rope (+$3,350)', sub:'WAR97740', parts:[{pn:'WAR97740',qty:1}]},
       {val:'war68801', label:'Warn 16.5ti — Roller Fairlead, Steel Cable (+$3,015)',   sub:'WAR68801', parts:[{pn:'WAR68801',qty:1}]},
     ],
    },
    {key:'front-center-light', label:'Center Section — Light Bar', badge:'opt',
     condition:(sel)=>['light','bravo'].includes(sel['front-series']),
     choices:()=>[
       {val:'none',       label:'No Light Bar — Cutout Included'},
       {val:'e-series',   label:'20" Rigid E-Series Spot/Flood Combo (+$860)',  sub:'RIG120313',    parts:[{pn:'RIG120313',qty:1}]},
       {val:'e-midnight', label:'20" Rigid E-Series Midnight Edition (+$860)',   sub:'RIG120213BLK', parts:[{pn:'RIG120213BLK',qty:1}]},
     ],
    },
    // Width (only for F-250/F-350 which have both options)
    ...(hasStockWidth ? [{
      key:'front-endcap', label:'End Cap Width', badge:'req',
      condition:(sel)=>{
        const s=sel['front-series'];
        if(!s) return false;
        if(s==='winch') return !!sel['front-center-winch'];
        return !!sel['front-center-light'];
      },
      choices:()=>[
        {val:'stock', label:'Stock Width'},
        {val:'wide',  label:'1.75" Wide End Caps'},
      ],
    }] : []),
    {key:'front-face', label:'Face Style', badge:'req',
     condition:(sel)=>{
       if(sel['front-series']!=='bravo') return false;
       return hasStockWidth ? !!sel['front-endcap'] : !!sel['front-center-light'];
     },
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Mounts'},
       {val:'clevis', label:'With Clevis Mounts'},
     ],
    },
    {key:'front-finish', label:'Bumper Finish', badge:'req',
     condition:(sel)=>{
       const s=sel['front-series'];
       if(!hasFront(sel['bumper-position'])||!s) return false;
       if(s==='bravo') return !!sel['front-face'];
       if(hasStockWidth) return !!sel['front-endcap'];
       return s==='winch' ? !!sel['front-center-winch'] : !!sel['front-center-light'];
     },
     choices:()=>finishChoices,
    },

    // ── REAR ──────────────────────────────────────────────────
    {key:'rear-series', label:'Rear Bumper Series', badge:'req',
     condition:(sel)=>{
       if(!hasRear(sel['bumper-position'])) return false;
       if(sel['bumper-position']==='front-rear') return !!sel['front-finish'];
       return true;
     },
     choices:()=>[
       {val:'alpha', label:'Alpha Series Rear'},
       {val:'bravo', label:'Bravo Series Rear'},
     ],
    },
    {key:'rear-face', label:'Rear Face Style', badge:'req',
     condition:(sel)=>sel['rear-series']==='bravo',
     choices:()=>[
       {val:'smooth', label:'Smooth Face — No Clevis Mounts'},
       {val:'clevis', label:'With Clevis Mounts'},
     ],
    },
    {key:'rear-parking', label:'Rear Parking Sensors', badge:'req',
     condition:(sel)=>sel['rear-series']==='alpha'||!!sel['rear-face'],
     choices:()=>[
       {val:'with',    label:'With Parking Sensor Cutouts'},
       {val:'without', label:'No Parking Sensor Cutouts'},
     ],
    },
    {key:'rear-finish', label:'Rear Bumper Finish', badge:'req',
     mirror:'front-finish',
     condition:(sel)=>!!sel['rear-parking'],
     choices:()=>finishChoices,
    },

    // ── ACCESSORIES ───────────────────────────────────────────
    {key:'front-lp', label:'License Plate Bracket', badge:'opt',
     condition:(sel)=>{
       if(!hasFront(sel['bumper-position'])||!sel['front-finish']) return false;
       if(sel['bumper-position']==='front-rear') return !!sel['rear-finish'];
       return true;
     },
     choices:()=>[
       {val:'no',  label:'No License Plate Bracket'},
       {val:'yes', label:'Add License Plate Bracket (31910)', sub:'Honeycomb Mesh — No Charge', parts:[{pn:'31910',qty:1}]},
     ],
    },
    {key:'front-wing-lights', label:'Outer Wing Lights', badge:'opt',
     condition:(sel)=>hasFront(sel['bumper-position'])&&!!sel['front-lp'],
     choices:()=>wingLightChoices(4),
    },
    {key:'front-hooks', label:'Front Tow Hooks', badge:'opt',
     mirror:'',
     condition:(sel)=>{
       if(!hasFront(sel['bumper-position'])||!sel['front-lp']) return false;
       if(sel['front-series']==='bravo') return sel['front-face']==='clevis';
       return true;
     },
     choices:()=>hookChoices,
    },
    {key:'rear-lights', label:'Rear Bumper Lights', badge:'opt',
     mirror:'front-wing-lights',
     condition:(sel)=>!!sel['rear-finish'],
     choices:()=>wingLightChoices(2),
    },
    {key:'rear-hooks', label:'Rear Bumper Hooks', badge:'opt',
     mirror:'front-hooks',
     condition:(sel)=>!!sel['rear-finish']&&(sel['rear-series']==='alpha'||sel['rear-face']==='clevis'),
     choices:()=>hookChoices,
    },
  ];

  return {
    id, yr_from, yr_to, make, model, label,
    kits:[{id:`${id}-kit`, label:'Bumper Configuration', sub:'Alpha & Bravo Series — front and rear bumpers with accessories'}],
    steps,
    buildParts:(kit,sel)=>{
      const parts = [];
      const bp    = sel['bumper-position']||'';
      const hookPN = {sw1b:'MH-SW1B',sw1c:'MH-SW1C',sw1s:'MH-SW1S',sw1a:'MH-SW1A',sw1r:'MH-SW1R',rs78xlb:'MH-RS78XLB'};
      const wingPN = {flood:'RIG104113',spot:'RIG104213','midnight-spot':'RIG104213BLK'};
      // Front bumper
      if(hasFront(bp)&&sel['front-series']){
        const pn = frontPN(sel['front-series'], getWide(sel), sel['front-face']==='clevis');
        if(pn) parts.push({section:'Front Bumper', pn, qty:1});
        // Winch
        if(sel['front-center-winch']==='war97740') parts.push({section:'Winch', pn:'WAR97740', qty:1});
        if(sel['front-center-winch']==='war68801') parts.push({section:'Winch', pn:'WAR68801', qty:1});
        // Center light bar
        const clMap={'e-series':'RIG120313','e-midnight':'RIG120213BLK'};
        if(clMap[sel['front-center-light']]) parts.push({section:'Bumper Lights', pn:clMap[sel['front-center-light']], qty:1});
        // Wing lights
        if(wingPN[sel['front-wing-lights']]) parts.push({section:'Bumper Lights', pn:wingPN[sel['front-wing-lights']], qty:4});
        // License plate
        if(sel['front-lp']==='yes') parts.push({section:'Accessories', pn:'31910', qty:1});
        // Front hooks
        const fh=sel['front-hooks'];
        if(fh&&fh!=='none'&&hookPN[fh]) parts.push({section:'Hooks', pn:hookPN[fh], qty:2});
      }
      // Rear bumper
      if(hasRear(bp)&&sel['rear-series']){
        const pn = rearPN(sel['rear-parking']==='with', sel['rear-series'], sel['rear-face']==='clevis');
        if(pn) parts.push({section:'Rear Bumper', pn, qty:1});
        if(wingPN[sel['rear-lights']]) parts.push({section:'Bumper Lights', pn:wingPN[sel['rear-lights']], qty:2});
        const rh=sel['rear-hooks'];
        if(rh&&rh!=='none'&&hookPN[rh]) parts.push({section:'Hooks', pn:hookPN[rh], qty:2});
      }
      return parts;
    },
  };
}


