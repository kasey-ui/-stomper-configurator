// CATALOG HELPERS
// ═══════════════════════════════════════════════════════════════
function getPlatform(id) { return CATALOG.find(p=>p.id===id); }
function getActivePlatform() { return getPlatform(S.platformId); }
function getActiveKit() {
  const p = getActivePlatform();
  // Also search all platforms for this model in case kitId belongs to a different platform
  if(!p || !p.kits.find(k=>k.id===S.kitId)) {
    const all = getPlatformsForModel(S.year, S.make, S.model);
    for(const ap of all) { const k=ap.kits.find(k=>k.id===S.kitId); if(k) return k; }
  }
  return p ? (p.kits.find(k=>k.id===S.kitId)||null) : null;
}
function getPlatformsForModel(year, make, model) {
  const y = parseInt(year);
  if(!y||!make||!model) return [];
  return CATALOG.filter(p=>p.yr_from<=y&&(p.yr_to===null||p.yr_to>=y)&&p.make===make&&p.model===model);
}
function getAllKitsForModel() {
  return getPlatformsForModel(S.year, S.make, S.model).flatMap(p=>p.kits.map(k=>({kit:k, platformId:p.id})));
}

// Build year list from CATALOG
function getYears() {
  const now = new Date().getFullYear()+1;
  const min = Math.min(...CATALOG.map(p=>p.yr_from));
  const years = [];
  for(let y=now; y>=min; y--) {
    if(CATALOG.some(p=>p.yr_from<=y&&(p.yr_to===null||p.yr_to>=y))) years.push(y);
  }
  return years;
}

function getMakes(year) {
  const y = parseInt(year);
  const makes = [...new Set(CATALOG
    .filter(p=>p.yr_from<=y&&(p.yr_to===null||p.yr_to>=y))
    .map(p=>p.make))].sort();
  return makes;
}

function getModels(year, make) {
  const y = parseInt(year);
  return CATALOG.filter(p=>p.yr_from<=y&&(p.yr_to===null||p.yr_to>=y)&&p.make===make);
}

