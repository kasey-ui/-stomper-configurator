        if(sel['front-shock']==='raptor'){parts.push({section:'Shocks',pn:'10008695',qty:1});parts.push({section:'Shocks',pn:'10008663',qty:1});}
        if(sel['front-shock']==='rr'){parts.push({section:'Shocks',pn:'10009579',qty:1});parts.push({section:'Shocks',pn:'10008663',qty:1});}
        if(sel['rear-shock']==='rr'){parts.push({section:'Shocks',pn:'10013505',qty:2});parts.push({section:'Shocks',pn:'10036751',qty:2});}
        const cMap={slkd:[{pn:'SLKD2WD',qty:1}],'dual-mech':[{pn:'30664',qty:1}]};
        (cMap[sel.ctrl]||[]).forEach(p=>parts.push({section:'Air Controls',...p}));
        if(sel.ctrl==='none') mfLine(false, sel.scope!=='front-only', false, false).forEach(p=>parts.push(p));
      }
      return parts;
    },
  };
}

