        'dual-mech': isBoth?[{pn:'30664',qty:1},{pn:'HCVLK',qty:2}]:[{pn:'30664',qty:1}],
        'eslk3h2':   [{pn:'ESLK3H2',qty:1}],
      };
      (ctrlMap[sel.ctrl]||[]).forEach(p=>parts.push({section:'Air Controls',...p}));
      if(sel.ctrl==='none') mfLine(s!=='rear-only'&&!!sel.drive, s!=='front-only'&&!!sel.rear, true, false).forEach(p=>parts.push(p));
