// ── URL compression (deflate-raw → url-safe base64) ────────────
async function _compressSel(sel) {
  const str = JSON.stringify(sel);
  if(!window.CompressionStream) return null;
  const cs = new CompressionStream('deflate-raw');
  const w = cs.writable.getWriter();
  w.write(new TextEncoder().encode(str));
  w.close();
  const buf = await new Response(cs.readable).arrayBuffer();
  let b = '';
  new Uint8Array(buf).forEach(c=>b+=String.fromCharCode(c));
  return btoa(b).replace(/\+/g,'-').replace(/\//g,'_').replace(/=/g,'');
}
async function _decompressSel(b64) {
  if(!window.DecompressionStream) return null;
  const bin = atob(b64.replace(/-/g,'+').replace(/_/g,'/'));
  const bytes = Uint8Array.from(bin, c=>c.charCodeAt(0));
  const ds = new DecompressionStream('deflate-raw');
  const w = ds.writable.getWriter();
  w.write(bytes);
  w.close();
  const buf = await new Response(ds.readable).arrayBuffer();
  return JSON.parse(new TextDecoder().decode(buf));
}

async function decodeBuildFromURL() {
  const params = new URLSearchParams(window.location.search);
  if(!params.has('pl')) return; // nothing to restore

  S.platformId = params.get('pl') || '';
  S.kitId      = params.get('kt') || '';
  // Derive year, make, model from platform (yr/mk no longer stored in URL)
  const _rp = getPlatform(S.platformId);
  if(_rp) {
    S.year  = params.get('yr') || String(_rp.yr_from);
    S.make  = params.get('mk') || _rp.make;
    S.model = _rp.model;
  } else {
    S.year = params.get('yr') || '';
    S.make = params.get('mk') || '';
  }
  _buildName   = params.get('bn') || '';
  if(!_buildName && params.has('br')) _buildRef = params.get('br');

  // restore step selections — compressed 'q' param or legacy 's_' params
  if(params.has('q')) {
    try { S.sel = (await _decompressSel(params.get('q'))) || {}; } catch(e) { S.sel = {}; }
  } else {
    params.forEach((v,k)=>{ if(k.startsWith('s_')) S.sel[k.slice(2)] = v; });
  }

  // restore customer ref
  const cr = params.get('cr');
  if(cr) setTimeout(()=>{ const el=document.getElementById('customer-ref'); if(el) el.value=cr; }, 50);

  // update YMM dropdowns to match restored state
  if(S.year) {
    const yrEl = document.getElementById('sel-year');
    yrEl.value = S.year;
    populateMakes();
    const mkEl = document.getElementById('sel-make');
    mkEl.value = S.make;
    populateModels();
    const mdEl = document.getElementById('sel-model');
    mdEl.value = S.model;
  }
}

