function buildPrintQuote() {
  const platform = getActivePlatform();
  const kit = getActiveKit();
  if(!platform||!kit) return;

  const allParts = platform.buildParts(S.kitId, S.sel);
  if(!allParts.length) return;

  // Consolidate duplicate P/Ns
  const pnMap = {};
  for(const item of allParts) {
    if(pnMap[item.pn]) pnMap[item.pn].qty += item.qty;
    else pnMap[item.pn] = {...item};
  }

  // Section order (mirrors render())
  const SECTION_ORDER = [
    'Bed','Front Suspension','Rear Suspension','Cradle Center','Lift Spacers','Radius Arms',
    'Steering Stabilizer','Air Controls','Shocks','Shocks (Included)',
    'Front Bumper','Rear Bumper','Winch',
    'Grille Guard','Grille Guard Lights','Bumper Lights','Accessories','Hooks',
    'Fender Flares','Wheels & Tires','Headache Rack','Fuel','Finish','Calibration',
  ];
  const sections = {};
  for(const item of Object.values(pnMap)) {
    if(!sections[item.section]) sections[item.section]=[];
    sections[item.section].push(item);
  }
  const sorted = Object.entries(sections).sort(([a],[b])=>{
    const ai=SECTION_ORDER.indexOf(a),bi=SECTION_ORDER.indexOf(b);
    if(ai===-1&&bi===-1) return 0; if(ai===-1) return 1; if(bi===-1) return -1; return ai-bi;
  });

  // Build item rows
  let itemNum=1, msrpTotal=0, rows='';
  for(const [, items] of sorted) {
    for(const item of items) {
      const pi = P[item.pn]||{desc:item.pn,msrp:0};
      const line = pi.msrp*item.qty;
      msrpTotal += line;
      rows += `<tr>
        <td class="pq-col-item">${itemNum++}</td>
        <td>
          <div class="pq-item-pn">${item.pn}</div>
          <div class="pq-item-desc">${pi.desc}${item.qty>1?' &nbsp;<em>(×'+item.qty+')</em>':''}</div>
        </td>
        <td class="pq-col-qty">${item.qty}</td>
        <td class="pq-col-price">${fmt(line)}</td>
      </tr>`;
    }
  }

  // Totals
  const labor = (_laborHours||0)*150;
  const discounted = _dealerDiscount>0 ? msrpTotal*(1-_dealerDiscount/100) : null;
  const tax = _taxExpanded ? (msrpTotal+labor)*0.07 : 0;
  const hasExtras = _laborExpanded||_taxExpanded||discounted!==null;
  const grand = hasExtras ? (discounted!==null?discounted:msrpTotal)+labor+tax : null;

  let tfoot = `<tr><td class="pq-total-lbl" colspan="3">Est. MSRP Total:</td><td class="pq-total-val">${fmtU(msrpTotal)}</td></tr>`;
  if(discounted!==null) tfoot += `<tr><td class="pq-total-lbl" colspan="3">Dealer Price (${_dealerDiscount}% off MSRP):</td><td class="pq-total-val">${fmtU(discounted)}</td></tr>`;
  if(_laborExpanded&&labor>0){
    if(_laborAuto){
      currentLaborLines().forEach(l=>{
        tfoot += `<tr><td class="pq-total-lbl" colspan="3">&nbsp;&nbsp;&nbsp;${l.label} (${l.hrs} hr):</td><td class="pq-total-val">${fmtU(l.hrs*150)}</td></tr>`;
      });
    }
    tfoot += `<tr><td class="pq-total-lbl" colspan="3">Install Labor (${_laborHours} hrs × $150/hr):</td><td class="pq-total-val">${fmtU(labor)}</td></tr>`;
  }
  if(_taxExpanded) tfoot += `<tr><td class="pq-total-lbl" colspan="3">Tax (7%):</td><td class="pq-total-val">${fmtU(tax)}</td></tr>`;
  if(grand!==null) tfoot += `<tr><td class="pq-grand-lbl" colspan="3">Grand Total:</td><td class="pq-grand-val">${fmtU(grand)}</td></tr>`;

  // Dates
  const now = new Date();
  const fmtD = d => `${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')}/${d.getFullYear()}`;
  const exp = new Date(now); exp.setDate(exp.getDate()+30);
  const vehicle = `${S.year} ${S.make} ${platform.label}`;
  const custRef = document.getElementById('customer-ref')?.value?.trim()||'';
  const qRef = displayRef();

  // The screen logo is white lettering on transparency and disappears on paper.
  // Use the print asset, which carries its own black field.
  const logoSrc = document.getElementById('logo-print-src')?.src
                || document.querySelector('.brand-logo')?.src || '';
  const logo = logoSrc
    ? `<img class="pq-logo-img" src="${logoSrc}">`
    : `<div style="font-family:Arial Black,Impact,sans-serif;font-size:20pt;font-weight:900;color:#111;letter-spacing:2px">KELDERMAN STOMPER</div>`;

  document.getElementById('print-quote').innerHTML = `
    <div class="pq-header">
      <div class="pq-logo">${logo}</div>
      <div class="pq-company">
        <div class="pq-company-name">Kelderman Manufacturing</div>
        2686 Hwy 92<br>Oskaloosa, IA 52577-9685<br>
        Phone: (641) 673-0468 &nbsp;·&nbsp; Fax: (641) 673-4168
      </div>
      <div class="pq-logo-spacer"></div>
    </div>
    <h1 class="pq-title">Quotation</h1>
    ${custRef?`<div class="pq-quote-to"><strong>Quote To:</strong><br>${custRef}</div>`:''}
    <table class="pq-meta-table">
      <tr>
        <td class="pq-meta-lbl">Quote Number:</td><td>${qRef}</td>
        <td class="pq-meta-lbl">Contact:</td><td>${custRef}</td>
      </tr>
      <tr>
        <td class="pq-meta-lbl">Quote Date:</td><td>${fmtD(now)}</td>
        <td class="pq-meta-lbl">Expires:</td><td>${fmtD(exp)}</td>
      </tr>
      <tr>
        <td class="pq-meta-lbl">Vehicle:</td><td colspan="3">${vehicle}</td>
      </tr>
    </table>
    <p class="pq-opener">Thank you for the opportunity to submit this quote.<br>
      <em>All prices are MSRP. Pricing subject to change. Does not include freight.</em></p>
    <table class="pq-items">
      <thead>
        <tr>
          <th class="pq-col-item">Item</th>
          <th><u>Part Number</u><br><u>Description</u></th>
          <th class="pq-col-qty">Qty</th>
          <th class="pq-col-price">Price</th>
        </tr>
      </thead>
      <tbody>${rows}</tbody>
      <tfoot>${tfoot}</tfoot>
    </table>
    <div class="pq-footer">
      <p>A 25% or more deposit is required to process a quotation and begin production.</p>
      <p>A 3.5% processing fee will be applied on all credit/debit card transactions. Wire transfers, ACH payments, and checks are also approved methods of payment.</p>
      <div class="pq-sig-block">
        <div class="pq-sig-line"></div>
        <div>By Sutherland, Kasey C</div>
        <div>Kelderman Manufacturing</div>
      </div>
      <div class="pq-report-line">
        <span>Report Generated: ${now.toLocaleDateString()} ${now.toLocaleTimeString()}</span>
        <span>Page 1 of 1</span>
      </div>
    </div>`;
}

function printSummary() {
  buildPrintQuote();
  document.body.classList.add('printing-quote');
  window.print();
  setTimeout(()=>document.body.classList.remove('printing-quote'), 500);
}

