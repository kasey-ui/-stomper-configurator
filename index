async function buildShareURL() {
  const base = window.location.href.split('?')[0];
  const params = new URLSearchParams();
  // yr and mk are derivable from pl — omit to keep URL short
  if(S.platformId) params.set('pl', S.platformId);
  if(S.kitId)      params.set('kt', S.kitId);
  if(_buildName)   params.set('bn', _buildName);
  else             params.set('br', _buildRef);
  const cr = document.getElementById('customer-ref').value.trim();
  if(cr) params.set('cr', cr);
  const q = await _compressSel(S.sel);
  if(q) {
    params.set('q', q);
  } else {
    Object.entries(S.sel).forEach(([k,v])=>{ if(v!==undefined&&v!=='') params.set('s_'+k, v); });
  }
  return base + '?' + params.toString();
}

