function runSearch(q) {
  const res = document.getElementById('search-results');
  const qLow = q.toLowerCase();
  const matches = Object.entries(P).filter(([pn, info]) =>
    pn.toLowerCase().includes(qLow) || info.desc.toLowerCase().includes(qLow)
  ).slice(0, 40);

  if (!matches.length) {
    res.innerHTML = '<div class="sr-none">No results for "' + q.replace(/</g,'&lt;') + '"</div>';
    res.style.display = 'block';
    return;
  }

  res.innerHTML = matches.map(([pn, info]) => {
    const price = info.msrp > 0 ? ' — $' + info.msrp.toLocaleString() : '';
    const line = '\'' + pn + '\'' + ' — ' + info.desc + (price);
    return '<div class="sr-item" onclick="copySearchResult(\'' + pn.replace(/'/g,"\\'") + '\',\'' +
      info.desc.replace(/'/g,"\\'").replace(/\n/g,' ') + '\',' + info.msrp + ')">' +
      '<div class="sr-pn">' + pn + '</div>' +
      '<div class="sr-text">' + info.desc + '</div>' +
      (info.msrp > 0 ? '<div class="sr-price">$' + info.msrp.toLocaleString() + '</div>' : '') +
      '</div>';
  }).join('');
  res.style.display = 'block';
}

function copySearchResult(pn, desc, msrp) {
  const price = msrp > 0 ? '. $' + msrp.toLocaleString() : '';
  const text = "'" + pn + "' — " + desc + price;
  navigator.clipboard.writeText(text).catch(()=>{});
  showSearchCopyToast(pn);
}

